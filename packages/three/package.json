{
  "name": "@backtickjs/three",
  "version": "0.182.0",
  "description": "The three.js adapter for Backtick: three's API as client values your scripts splice, and its classes' types",
  "keywords": [
    "backtick",
    "three",
    "threejs",
    "3d",
    "server-driven-ui",
    "adapter"
  ],
  "homepage": "https://backtickjs.com",
  "bugs": {
    "url": "https://github.com/backtickjs/backtick/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backtickjs/backtick.git",
    "directory": "packages/three"
  },
  "license": "MIT",
  "author": "Jean-François Bisson <jf@backtickjs.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/._cache",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "backtick-tsc -p tsconfig.build.json --noEmit",
    "build": "tspc -b --noCheck --force",
    "dev": "tspc -b --noCheck --watch",
    "test": "node --test \"test/**/*.test.ts\"",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@backtickjs/core": "workspace:^0.1.0",
    "@types/three": "0.182.0",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@backtickjs/compiler": "workspace:^0.1.0",
    "@backtickjs/prettier-plugin": "workspace:*",
    "@backtickjs/tsc": "workspace:^0.1.0",
    "@backtickjs/tspatch-plugin": "workspace:^0.1.0",
    "prettier": "^3.6.2",
    "ts-patch": "^4.0.1",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "plugins": [
      "@backtickjs/prettier-plugin"
    ]
  }
}
