{
  "name": "@backtickjs/expo",
  "version": "0.2.4",
  "description": "Backtick for Expo apps: the config plugin that records the app's installed packages, and reloading apps when the server restarts",
  "keywords": [
    "backtick",
    "expo",
    "react-native",
    "server-driven-ui"
  ],
  "homepage": "https://backtickjs.com",
  "bugs": {
    "url": "https://github.com/backtickjs/backtick/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backtickjs/backtick.git",
    "directory": "packages/expo"
  },
  "license": "MIT",
  "author": "Jean-François Bisson <jf@backtickjs.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./app.plugin": "./dist/app.plugin.js",
    "./app.plugin.js": "./dist/app.plugin.js"
  },
  "files": [
    "dist",
    "!dist/._cache",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "test": "node --test \"test/**/*.test.ts\"",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@backtickjs/core": "^0.2.4"
  },
  "peerDependencies": {
    "expo": "*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.2",
    "expo": "~57.0.26",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "ws": "^8.22.0"
  }
}
