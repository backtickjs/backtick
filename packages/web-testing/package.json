{
  "name": "@backtickjs/web-testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The web interpreter drawing into a happy-dom page, for rendering Backtick apps in tests",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo"
  },
  "dependencies": {
    "@backtickjs/bundler": "workspace:*",
    "@backtickjs/core": "workspace:*",
    "@backtickjs/web-interpreter": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.7",
    "happy-dom": "^20.14.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
