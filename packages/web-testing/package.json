{
  "name": "@backtickjs/web-testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Testing Library for Backtick on the web: render a value into the test environment's document",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pure": {
      "types": "./dist/pure.d.ts",
      "default": "./dist/pure.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo"
  },
  "dependencies": {
    "@backtickjs/bundler": "workspace:*",
    "@backtickjs/core": "workspace:*",
    "@testing-library/dom": "^10.4.2"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
