{
  "name": "@backtickjs/web-interpreter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node scripts/build.mjs",
    "test": "node --test \"test/**/*.test.ts\"",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo"
  },
  "dependencies": {
    "@backtickjs/platform-sdk": "workspace:*",
    "@backtickjs/web-sdk": "workspace:*"
  },
  "peerDependencies": {
    "@backtickjs/core": "workspace:*"
  },
  "devDependencies": {
    "@backtickjs/core": "workspace:*",
    "esbuild": "0.28.0",
    "prettier": "^3.6.2",
    "solid-js": "^1.9.14",
    "typescript": "^6.0.3"
  }
}
