{
  "name": "@backtickjs/prettier-plugin",
  "version": "0.1.4",
  "description": "A Prettier plugin that formats the code inside Backtick client scripts",
  "keywords": [
    "backtick",
    "react-native",
    "server-driven-ui",
    "server-components",
    "prettier",
    "prettier-plugin",
    "formatter"
  ],
  "homepage": "https://backtickjs.com",
  "bugs": {
    "url": "https://github.com/backtickjs/backtick/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backtickjs/backtick.git",
    "directory": "packages/prettier-plugin"
  },
  "license": "MIT",
  "author": "Jean-François Bisson <jf@backtickjs.com>",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "!dist/._cache",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:update": "UPDATE_SNAPSHOTS=1 node --import tsx --test \"test/**/*.test.ts\"",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "devDependencies": {
    "@types/estree": "^1.0.9",
    "prettier": "^3.6.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@backtickjs/compiler": "workspace:*"
  },
  "peerDependencies": {
    "prettier": "^3.0.0",
    "typescript": "^6.0.3"
  }
}
