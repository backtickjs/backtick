{
  "name": "@backtickjs/jsx-react",
  "version": "0.2.4",
  "description": "React's JSX for Backtick: a JSX runtime for server components, and the compile plugin for scripts",
  "keywords": [
    "backtick",
    "react-native",
    "server-driven-ui",
    "server-components",
    "react",
    "jsx-runtime"
  ],
  "homepage": "https://backtickjs.com",
  "bugs": {
    "url": "https://github.com/backtickjs/backtick/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backtickjs/backtick.git",
    "directory": "packages/jsx-react"
  },
  "license": "MIT",
  "author": "Jean-François Bisson <jf@backtickjs.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "!dist/._cache",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "backtick-tsc -p tsconfig.build.json --noEmit",
    "build": "tspc -b --noCheck --force",
    "dev": "tspc -b --noCheck --watch",
    "test": "node --test \"test/**/*.test.ts\"",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@backtickjs/core": "^0.2.4"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "@types/react": "^19.2.18",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@backtickjs/bundler": "^0.2.4",
    "@backtickjs/compiler": "^0.2.4",
    "@backtickjs/prettier-plugin": "^0.2.4",
    "@backtickjs/tsc": "^0.2.4",
    "@backtickjs/tspatch-plugin": "^0.2.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "global-jsdom": "^30.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ts-patch": "^4.0.1",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "plugins": [
      "@backtickjs/prettier-plugin"
    ]
  }
}
