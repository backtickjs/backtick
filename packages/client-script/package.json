{
  "name": "@backtickjs/client-script",
  "version": "0.1.0",
  "private": true,
  "description": "Internal: use `@backtickjs/core`, which re-exports `cs`. The host/client boundary: what a client may hold, what a host may write for one, and what a drawing is",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@backtickjs/platform-sdk": "workspace:*",
    "@types/estree": "^1.0.9",
    "@types/estree-jsx": "^1.0.5"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
