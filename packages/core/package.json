{
  "name": "@backtickjs/core",
  "version": "0.1.0",
  "private": true,
  "description": "The cs tag for Backtick client scripts, and the types for the values that cross from server to client",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepack": "cp ../../LICENSE ."
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "license": "MIT"
}
