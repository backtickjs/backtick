{
  "name": "@backtickjs/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    },
    "./cs-runtime": {
      "types": "./dist/cs-runtime/index.d.ts",
      "default": "./dist/cs-runtime/index.js"
    },
    "./jit-bundler": {
      "types": "./dist/jit-bundler/index.d.ts",
      "default": "./dist/jit-bundler/index.js"
    },
    "./test-client": {
      "types": "./dist/test-client/index.d.ts",
      "default": "./dist/test-client/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime/index.d.ts",
      "default": "./dist/jsx-runtime/index.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime/index.d.ts",
      "default": "./dist/jsx-dev-runtime/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:update": "UPDATE_SNAPSHOTS=1 node --test \"test/**/*.test.ts\"",
    "clean": "rm -rf node_modules dist .turbo"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
