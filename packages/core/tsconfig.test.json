{
  "extends": "../../configs/tsconfig.test.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@backtickjs/core"
  },
  "include": [
    "test/**/*.mts",
    "test/**/*.mjs",
    "test/**/*.ts",
    "test/**/*.runtime.tsx",
    "test/**/*.virtual.tsx"
  ],
  "exclude": ["test/fixtures/valid/*.ts", "test/fixtures/invalid/*.ts"],
  "references": [{ "path": "./tsconfig.build.json" }]
}
