{
  "name": "@backtickjs/web-page",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The page both halves agree on: the server writes bundles into it, the client draws them",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo"
  },
  "dependencies": {
    "@backtickjs/bundler": "workspace:*",
    "@backtickjs/web-interpreter": "workspace:*"
  },
  "peerDependencies": {
    "@backtickjs/core": "workspace:*"
  },
  "devDependencies": {
    "@backtickjs/core": "workspace:*",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
