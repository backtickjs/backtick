{
  "name": "@backtickjs/dev",
  "version": "0.1.10",
  "description": "Backtick in development: `backtick-dev` runs your server, restarts it when you save, reloads the app once it's back, and keeps both sides' logs",
  "keywords": [
    "backtick",
    "server-driven-ui",
    "hot-reload",
    "mcp"
  ],
  "homepage": "https://backtickjs.com",
  "bugs": {
    "url": "https://github.com/backtickjs/backtick/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backtickjs/backtick.git",
    "directory": "packages/dev"
  },
  "license": "MIT",
  "author": "Jean-François Bisson <jf@backtickjs.com>",
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "bin": {
    "backtick-dev": "./dist/cli.js",
    "backtick-dev-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "!dist/._cache",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "test": "node --test --test-timeout=20000 \"test/**/*.test.ts\"",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13",
    "undici": "^8.10.2",
    "ws": "^8.22.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
