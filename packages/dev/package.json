{
  "name": "@backtickjs/dev",
  "version": "0.1.10",
  "description": "Backtick in development: `node --watch --import @backtickjs/dev/reload` reloads the app each time your server restarts",
  "keywords": [
    "backtick",
    "server-driven-ui",
    "hot-reload",
    "expo"
  ],
  "homepage": "https://backtickjs.com",
  "bugs": {
    "url": "https://github.com/backtickjs/backtick/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backtickjs/backtick.git",
    "directory": "packages/dev"
  },
  "license": "MIT",
  "author": "Jean-François Bisson <jf@backtickjs.com>",
  "type": "module",
  "exports": {
    "./reload": {
      "types": "./dist/reload.d.ts",
      "default": "./dist/reload.js"
    }
  },
  "files": [
    "dist",
    "!dist/._cache",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "test": "node --test --test-timeout=20000 \"test/**/*.test.ts\"",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "ws": "^8.22.0"
  }
}
