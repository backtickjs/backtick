{
  "name": "@backtickjs/bun-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo"
  },
  "peerDependencies": {
    "@backtickjs/compiler": "workspace:*",
    "@backtickjs/core": "workspace:^",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@backtickjs/compiler": "workspace:*",
    "@types/bun": "^1.3.14",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
