{
  "name": "@backtickjs/bun-plugin",
  "version": "0.1.2",
  "description": "Runs a Backtick server on Bun without a build step, compiling its files and client scripts as they load",
  "keywords": [
    "backtick",
    "react-native",
    "server-driven-ui",
    "server-components",
    "bun",
    "plugin",
    "loader"
  ],
  "homepage": "https://backtickjs.com",
  "bugs": {
    "url": "https://github.com/backtickjs/backtick/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backtickjs/backtick.git",
    "directory": "packages/bun-plugin"
  },
  "license": "MIT",
  "author": "Jean-François Bisson <jf@backtickjs.com>",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/._cache",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "bun test",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@backtickjs/compiler": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@backtickjs/core": "workspace:*",
    "@types/bun": "^1.3.14",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
