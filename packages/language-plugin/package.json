{
  "name": "@backtickjs/language-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Internal: used by `@backtickjs/tsc` and the editor tooling. The Volar plugin that shows TypeScript what a `cs` script means",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo"
  },
  "dependencies": {
    "@backtickjs/compiler": "workspace:*",
    "@volar/language-core": "^2.4.28",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "@volar/language-server": "^2.4.28",
    "@volar/typescript": "^2.4.28",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
