{
  "name": "@backtickjs/language-plugin",
  "version": "0.1.4",
  "description": "Internal: the Volar language plugin that shows TypeScript what a Backtick client script means",
  "keywords": [
    "backtick",
    "react-native",
    "server-driven-ui",
    "server-components",
    "volar",
    "typescript",
    "language-tools"
  ],
  "homepage": "https://backtickjs.com",
  "bugs": {
    "url": "https://github.com/backtickjs/backtick/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backtickjs/backtick.git",
    "directory": "packages/language-plugin"
  },
  "license": "MIT",
  "author": "Jean-François Bisson <jf@backtickjs.com>",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/._cache",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@backtickjs/compiler": "workspace:*",
    "@volar/language-core": "^2.4.28"
  },
  "devDependencies": {
    "@volar/typescript": "^2.4.28",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
