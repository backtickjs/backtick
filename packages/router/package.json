{
  "name": "@backtickjs/router",
  "version": "0.2.6",
  "description": "expo-router's Link and router for Backtick: the next screen is fetched before it's shown, and the current one stays until then.",
  "keywords": [
    "backtick",
    "react-native",
    "server-driven-ui",
    "router",
    "navigation"
  ],
  "homepage": "https://backtickjs.com",
  "bugs": {
    "url": "https://github.com/backtickjs/backtick/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backtickjs/backtick.git",
    "directory": "packages/router"
  },
  "license": "MIT",
  "author": "Jean-François Bisson <jf@backtickjs.com>",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/._cache",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "test": "node --test \"test/**/*.test.ts\"",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.80"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "prettier": "^3.6.2",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "typescript": "^6.0.3"
  }
}
