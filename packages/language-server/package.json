{
  "name": "@backtickjs/language-server",
  "version": "0.1.3",
  "private": true,
  "description": "Internal: a Volar language server for Backtick client scripts, used by the VS Code extension in development",
  "license": "MIT",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@backtickjs/language-plugin": "workspace:*",
    "@volar/language-server": "^2.4.28",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
