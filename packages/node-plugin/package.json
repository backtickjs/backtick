{
  "name": "@backtickjs/node-plugin",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Runs a Backtick server on Node without a build step, compiling its files and client scripts as they load",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "node --enable-source-maps --import ./dist/index.js --test \"test/**/*.test.ts\"",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@backtickjs/compiler": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@backtickjs/core": "workspace:*",
    "@types/node": "^25.9.1",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.15"
  }
}
