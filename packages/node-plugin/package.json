{
  "name": "@backtickjs/node-plugin",
  "version": "0.1.1",
  "description": "Runs a Backtick server on Node without a build step, compiling its files and client scripts as they load",
  "keywords": [
    "backtick",
    "react-native",
    "server-driven-ui",
    "server-components",
    "node",
    "loader",
    "module-hooks"
  ],
  "homepage": "https://backtickjs.com",
  "bugs": {
    "url": "https://github.com/backtickjs/backtick/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backtickjs/backtick.git",
    "directory": "packages/node-plugin"
  },
  "license": "MIT",
  "author": "Jean-François Bisson <jf@backtickjs.com>",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/._cache",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "node --enable-source-maps --import ./dist/index.js --test \"test/**/*.test.ts\"",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@backtickjs/compiler": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@backtickjs/core": "workspace:*",
    "@types/node": "^25.9.1",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.15"
  }
}
