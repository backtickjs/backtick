{
  "name": "@backtickjs/browser-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backtick's compiler, whole, in a browser",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./static/*": "./static/*"
  },
  "scripts": {
    "build": "tsc -b && node build.mjs",
    "typecheck": "tsc -b",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist static .turbo"
  },
  "dependencies": {
    "@backtickjs/compiler": "workspace:*",
    "@backtickjs/core": "workspace:*",
    "@backtickjs/web-sdk": "workspace:*",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2"
  }
}
