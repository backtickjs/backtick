{
  "name": "@backtickjs/bundler",
  "version": "0.8.0",
  "description": "Runs Backtick server components and bundles a screen per request: one JavaScript file for the client",
  "keywords": [
    "backtick",
    "react-native",
    "server-driven-ui",
    "server-components",
    "bundler",
    "bundle",
    "jsx"
  ],
  "homepage": "https://backtickjs.com",
  "bugs": {
    "url": "https://github.com/backtickjs/backtick/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backtickjs/backtick.git",
    "directory": "packages/bundler"
  },
  "license": "MIT",
  "author": "Jean-François Bisson <jf@backtickjs.com>",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/._cache",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tspc -b --noCheck --force",
    "dev": "tspc -b --noCheck --watch",
    "typecheck": "backtick-tsc -p tsconfig.build.json --noEmit",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "test": "backtick-tsc -p tsconfig.test.json --noEmit && node --enable-source-maps --import @backtickjs/node-plugin --test \"test/**/*.test.ts\"",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@backtickjs/core": "0.8.0",
    "semver": "^7.8.1"
  },
  "devDependencies": {
    "@backtickjs/node-plugin": "0.8.0",
    "@backtickjs/tsc": "0.8.0",
    "@backtickjs/tspatch-plugin": "0.8.0",
    "@types/semver": "^7.8.0",
    "hono": "^4.13.13",
    "prettier": "^3.6.2",
    "ts-patch": "^4.0.1",
    "typescript": "^6.0.3"
  }
}
