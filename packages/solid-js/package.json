{
  "name": "@backtickjs/solid-js",
  "version": "1.9.14",
  "private": true,
  "description": "Backtick's Solid adapter: scripts written as Solid code, compiled by Solid's own compiler and run on Solid",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "scripts": {
    "typecheck": "backtick-tsc -p tsconfig.build.json --noEmit",
    "build": "tspc -b --noCheck --force",
    "dev": "tspc -b --noCheck --watch",
    "test": "node --conditions=browser --test \"test/**/*.test.ts\"",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@backtickjs/core": "workspace:^0.1.0",
    "babel-preset-solid": "1.9.12",
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "@backtickjs/prettier-plugin": "workspace:*",
    "@backtickjs/tsc": "workspace:^0.1.0",
    "@backtickjs/tspatch-plugin": "workspace:^0.1.0",
    "@types/babel__core": "^7.20.5",
    "prettier": "^3.6.2",
    "ts-patch": "^4.0.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {},
  "peerDependenciesMeta": {},
  "prettier": {
    "plugins": [
      "@backtickjs/prettier-plugin"
    ]
  }
}
