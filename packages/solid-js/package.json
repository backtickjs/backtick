{
  "name": "@backtickjs/solid-js",
  "version": "1.9.14",
  "private": true,
  "description": "Backtick's Solid adapter: scripts written as Solid code, compiled by Solid's own compiler and run on Solid",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "node --conditions=browser --test \"test/**/*.test.ts\"",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@backtickjs/core": "workspace:^0.1.0",
    "babel-preset-solid": "1.9.12",
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "@backtickjs/bundler": "workspace:^0.1.0",
    "@types/babel__core": "^7.20.5",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {},
  "peerDependenciesMeta": {}
}
