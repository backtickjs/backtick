{
  "name": "@backtickjs/solid-js",
  "version": "0.1.0",
  "private": true,
  "description": "Backtick's Solid adapter: scripts written as Solid code, compiled by Solid's own compiler and run on Solid",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./transform": {
      "types": "./dist/transform.d.ts",
      "default": "./dist/transform.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "node --conditions=browser --test \"test/**/*.test.ts\"",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@backtickjs/bundler": "workspace:^0.1.0",
    "@backtickjs/platform-sdk": "workspace:^0.1.0",
    "babel-preset-solid": "1.9.12",
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "@backtickjs/compiler": "workspace:^0.1.0",
    "@backtickjs/web-testing": "workspace:^0.1.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.2",
    "global-jsdom": "^30.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@backtickjs/web-testing": "workspace:^0.1.0"
  },
  "peerDependenciesMeta": {
    "@backtickjs/web-testing": {
      "optional": true
    }
  }
}
