{
  "name": "@backtickjs/web-sdk",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./server/node": {
      "types": "./dist/server-node.d.ts",
      "default": "./dist/server-node.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo"
  },
  "dependencies": {
    "@backtickjs/jit-bundler": "workspace:*",
    "@backtickjs/js-interpreter": "workspace:*",
    "@backtickjs/web-client": "workspace:*",
    "@backtickjs/web-server": "workspace:*"
  },
  "peerDependencies": {
    "@backtickjs/core": "workspace:*"
  },
  "devDependencies": {
    "@backtickjs/core": "workspace:*",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
