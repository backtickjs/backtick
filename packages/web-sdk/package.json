{
  "name": "@backtickjs/web-sdk",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server/node": {
      "types": "./dist/server/node.d.ts",
      "default": "./dist/server/node.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime/index.d.ts",
      "default": "./dist/jsx-runtime/index.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime/index.d.ts",
      "default": "./dist/jsx-dev-runtime/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node scripts/browser.mjs",
    "dev": "tsc -b --watch",
    "test": "node --test \"test/**/*.test.ts\"",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo"
  },
  "dependencies": {
    "@backtickjs/cs-runtime": "workspace:*",
    "@backtickjs/js-interpreter": "workspace:*",
    "solid-js": "^1.9.14"
  },
  "peerDependencies": {
    "@backtickjs/core": "workspace:*"
  },
  "devDependencies": {
    "@backtickjs/core": "workspace:*",
    "esbuild": "0.28.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
