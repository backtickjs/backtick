{
  "name": "@backtickjs/web-sdk",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime/index.d.ts",
      "default": "./dist/jsx-runtime/index.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime/index.d.ts",
      "default": "./dist/jsx-dev-runtime/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "generate": "backtick-generate src/schema.ts",
    "test": "node --conditions=browser --test \"test/**/*.test.ts\"",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo"
  },
  "dependencies": {
    "@backtickjs/core-schema": "workspace:*",
    "@backtickjs/cs-runtime": "workspace:*",
    "@backtickjs/schema": "workspace:*",
    "@backtickjs/web-client": "workspace:*",
    "linkedom": "^0.18.13"
  },
  "peerDependencies": {
    "@backtickjs/core": "workspace:*"
  },
  "devDependencies": {
    "@backtickjs/core": "workspace:*",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
