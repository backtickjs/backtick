            "type": "ref",
            "$ref": "State"
          },
          "arguments": [
            {
              "type": "ref",
              "$ref": "T"
            }
          ]
        }
      }
    },
    "computed": {
      "description": "Creates a read-only `Signal` that derives its value from other signals. The calculated value is memoized: `fn` runs when the computed is created and again only when a signal it read changes, and every `get` reuses the result. If the new result equals the previous one (`===`, or `options.equals`), the computed doesn't update whatever reads it.\n\nCreated while a script draws, it lasts as long as that drawing.",
      "type": "generic",
      "parameters": [
        {
          "type": "genericParameter",
          "name": "T",
          "extends": {
            "type": "unknown"
