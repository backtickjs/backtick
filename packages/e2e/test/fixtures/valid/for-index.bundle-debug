#f0 = ($0) => () => {
  $0().update((held) => [held[2], held[0], held[1]]);
}

#f1 = ($0) => $0().read()

#f2 = ($0) => (name, index) => $0(name, index)

#f3 = ($0, $1) => $0 + " at " + $1.read()

#f4 = (name, index) => <span>
  {#f3(name, index)}
</span>

#f5 = () => {
  const s0 = state(["a", "b", "c"]);
  return <div>
    {<span
      onclick={#f0(() => s0)}
    >
      {"rotate"}
    </span>}
    {<div>
      {<For
        each={#f1(() => s0)}
      >
        {#f2((name, index) => #f4(name, index))}
      </For>}
    </div>}
  </div>;
}

root = #f5()
