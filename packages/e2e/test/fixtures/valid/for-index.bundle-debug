#f0 = ($0) => {
  const names = state(["a", "b", "c"]);
  const rotate = () => {
    names.update((held) => [held[2], held[0], held[1]]);
  };
  return <div>
    {<span
      onclick={rotate}
    >
      {"rotate"}
    </span>}
    {<div>
      {$0()({
        "each": () => names.read(),
        "children": () => (name, index) => <span>
          {name + " at " + index.read()}
        </span>
      })}
    </div>}
  </div>;
}

#f1 = ($0) => <for
  each={$0.each()}
>
  {$0.children()}
</for>

#f2 = () => #f0(() => ($0) => #f1($0))

root = #f2()
