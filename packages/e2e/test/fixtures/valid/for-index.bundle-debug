#f0 = ($0) => () => {
  $0().update((held) => [held[2], held[0], held[1]]);
}

#f1 = ($0) => $0().read()

#f2 = ($0) => (name, index) => $0(name, index)

#f3 = ($0, $1) => $0 + " at " + $1.read()

#t0 = () => <Text>
  {#f3(slots[0], slots[1])}
</Text>

#t1 = () => {
  const s0 = state(["a", "b", "c"]);
  return <View>
    {<Text
      onPress={#f0(() => s0)}
    >
      {"rotate"}
    </Text>}
    {<View>
      {<For
        each={#f1(() => s0)}
      >
        {#f2((name, index) => #t0(name, index))}
      </For>}
    </View>}
  </View>;
}

root = #t1()
