#f0 = ($0) => {
  const ids = state([1, 2, 3]);
  const swap = () => {
    ids.update((held) => held.with(0, held[2]).with(2, held[0]));
  };
  const drop = () => {
    ids.update((held) => held.filter((id) => id !== 2));
  };
  return <div>
    {<span
      onclick={swap}
    >
      {"swap"}
    </span>}
    {<span
      onclick={drop}
    >
      {"drop"}
    </span>}
    {<div>
      {$0()({
        "each": () => ids.read(),
        "children": () => (id) => <span>
          {"row " + id}
        </span>
      })}
    </div>}
  </div>;
}

#f1 = ($0) => <for
  each={$0.each()}
>
  {$0.children()}
</for>

root = #f0(() => ($0) => #f1($0))
