#f0 = ($0) => () => {
  $0().update((held) => held.with(0, held[2]).with(2, held[0]));
}

#f1 = ($0) => () => {
  $0().update((held) => held.filter((id) => id !== 2));
}

#f2 = ($0) => $0().read()

#f3 = ($0) => (id) => $0(id)

#f4 = ($0) => "row " + $0

#t0 = <Text>
  {#f4(slots[0])}
</Text>

#t1 state { s0 = [1, 2, 3] } = <View>
  {<Text
    onPress={#f0(() => cells.s0)}
  >
    {"swap"}
  </Text>}
  {<Text
    onPress={#f1(() => cells.s0)}
  >
    {"drop"}
  </Text>}
  {<View>
    {<For
      each={#f2(() => cells.s0)}
    >
      {#f3((id) => #t0(id))}
    </For>}
  </View>}
</View>

root = #t1()
