#f0 = ($0) => () => {
  $0().update((held) => held.with(0, held[2]).with(2, held[0]));
}

#f1 = ($0) => () => {
  $0().update((held) => held.filter((id) => id !== 2));
}

#f2 = ($0) => $0().read()

#f3 = ($0) => (id) => $0(id)

#f4 = ($0) => "row " + $0

#f5 = (id) => <Text>
  {#f4(id)}
</Text>

#f6 = () => {
  const s0 = state([1, 2, 3]);
  return <View>
    {<Text
      onPress={#f0(() => s0)}
    >
      {"swap"}
    </Text>}
    {<Text
      onPress={#f1(() => s0)}
    >
      {"drop"}
    </Text>}
    {<View>
      {<For
        each={#f2(() => s0)}
      >
        {#f3((id) => #f5(id))}
      </For>}
    </View>}
  </View>;
}

root = #f6()
