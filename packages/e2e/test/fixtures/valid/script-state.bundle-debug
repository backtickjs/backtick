#f0 = () => "font-size: 16px"

#f1 = ($0) => () => {
  const row = $0()("one");
  row.label.write(row.label.read() + " !!!");
}

#f2 = () => (label) => {
  return { "label": state(label) };
}

#f3 = ($0) => $0()("one").label.read()

#f4 = () => <span
  style={#f0()}
  onclick={#f1(#f2)}
>
  {#f3(#f2)}
</span>

root = #f4()
