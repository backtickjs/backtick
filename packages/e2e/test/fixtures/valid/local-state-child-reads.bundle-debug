#f0 = ($0) => () => $0().write(1)

#f1 = ($0, $1) => $0().read() === $1() ? 20 : 16

#f2 = () => 0

#f3 = ($0, $1) => "row " + $0() + " of " + $1().read()

#f4 = ($0, $1, $2) => $0().read() === $1() ? $2() : null

#f5 = () => 1

#f6 = () => <Text>
  {"marker"}
</Text>

#f7 = (s0) => <View>
  {<Text
    style={{ "fontSize": #f1(() => s0, #f2) }}
  >
    {#f3(#f2, () => s0)}
  </Text>}
  {#f4(() => s0, #f2, () => #f6())}
</View>

#f8 = () => <Text>
  {"marker"}
</Text>

#f9 = (s0) => <View>
  {<Text
    style={{ "fontSize": #f1(() => s0, #f5) }}
  >
    {#f3(#f5, () => s0)}
  </Text>}
  {#f4(() => s0, #f5, () => #f8())}
</View>

#f10 = () => {
  const s0 = state(0);
  return <View>
    {<Text
      onPress={#f0(() => s0)}
    >
      {"select"}
    </Text>}
    {#f7(s0)}
    {#f9(s0)}
  </View>;
}

root = #f10()
