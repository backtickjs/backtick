#f0 = ($0) => {
  const selected = state(0);
  return <div>
    {<span
      onclick={() => selected.write(1)}
    >
      {"select"}
    </span>}
    {$0()({ "id": () => 0, "selected": () => selected })}
    {$0()({ "id": () => 1, "selected": () => selected })}
  </div>;
}

#f1 = ($0, $1) => "font-size: " + $0().read() === $1() ? 20 : 16 + "px"

#f2 = ($0, $1) => "row " + $0() + " of " + $1().read()

#f3 = ($0, $1, $2) => $0().read() === $1() ? $2() : null

root = #f0(() => ($0) => <div>
  {<span
    style={#f1(() => $0.selected(), () => $0.id())}
  >
    {#f2(() => $0.id(), () => $0.selected())}
  </span>}
  {#f3(() => $0.selected(), () => $0.id(), () => <span>
    {"marker"}
  </span>)}
</div>)
