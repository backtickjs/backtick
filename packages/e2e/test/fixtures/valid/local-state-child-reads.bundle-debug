#f0 = ($0) => () => $0().write(1)

#f1 = ($0, $1) => "font-size: " + $0().read() === $1() ? 20 : 16 + "px"

#f2 = () => 0

#f3 = ($0, $1) => "row " + $0() + " of " + $1().read()

#f4 = ($0, $1, $2) => $0().read() === $1() ? $2() : null

#f5 = () => 1

#f6 = () => <span>
  {"marker"}
</span>

#f7 = (s0) => <div>
  {<span
    style={#f1(() => s0, #f2)}
  >
    {#f3(#f2, () => s0)}
  </span>}
  {#f4(() => s0, #f2, () => #f6())}
</div>

#f8 = () => <span>
  {"marker"}
</span>

#f9 = (s0) => <div>
  {<span
    style={#f1(() => s0, #f5)}
  >
    {#f3(#f5, () => s0)}
  </span>}
  {#f4(() => s0, #f5, () => #f8())}
</div>

#f10 = () => {
  const s0 = state(0);
  return <div>
    {<span
      onclick={#f0(() => s0)}
    >
      {"select"}
    </span>}
    {#f7(s0)}
    {#f9(s0)}
  </div>;
}

root = #f10()
