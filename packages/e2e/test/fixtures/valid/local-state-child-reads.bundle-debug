#f0 = ($0) => () => $0().write(1)

#f1 = ($0, $1) => $0().read() === $1() ? 20 : 16

#f2 = () => 0

#f3 = ($0, $1) => "row " + $0() + " of " + $1().read()

#f4 = ($0, $1, $2) => $0().read() === $1() ? $2() : null

#f5 = () => 1

#t0 = <Text>
  {"marker"}
</Text>

#t1 = <View>
  {<Text
    style={{ "fontSize": #f1(() => slots[0], #f2) }}
  >
    {#f3(#f2, () => slots[0])}
  </Text>}
  {#f4(() => slots[0], #f2, () => #t0())}
</View>

#t2 = <Text>
  {"marker"}
</Text>

#t3 = <View>
  {<Text
    style={{ "fontSize": #f1(() => slots[0], #f5) }}
  >
    {#f3(#f5, () => slots[0])}
  </Text>}
  {#f4(() => slots[0], #f5, () => #t2())}
</View>

#t4 state { s0 = 0 } = <View>
  {<Text
    onPress={#f0(() => cells.s0)}
  >
    {"select"}
  </Text>}
  {#t1(cells.s0)}
  {#t3(cells.s0)}
</View>

root = #t4()
