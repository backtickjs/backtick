#f0 = () => {
  "missing": #f1()(null, true),
  "loud": #f1()("!hi", true),
  "quiet": #f1()("!hi", false),
  "plain": #f1()("zz", false)
}

#f1 = () => (text, upper) => {
  if (upper && text !== null) {
    return text.toUpperCase();
  }
  if (#f2() && text !== null && text.charAt(0) === "!") {
    return text.concat("?");
  }
  return "none";
}

#f2 = () => true

root = #f0()
