#f0 = ($0) => () => {
  $0().update(() => []);
}

#f1 = ($0) => $0().read()

#f2 = ($0) => (id) => $0(id)

#f3 = ($0) => "row " + $0

#f4 = (id) => <span>
  {#f3(id)}
</span>

#f5 = (s0) => <for
  each={#f1(() => s0)}
>
  {#f2((id) => #f4(id))}
</for>

#f6 = (s0) => [
  <span
    onclick={#f0(() => s0)}
  >
