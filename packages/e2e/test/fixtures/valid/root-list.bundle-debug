#f0 = ($0) => {
  const ids = state([1, 2, 3]);
  const clear = () => {
    ids.update(() => []);
  };
  return [
    <span
      onclick={clear}
    >
      {"clear"}
    </span>,
    $0()({
      "each": () => ids.read(),
      "children": () => (id) => <span>
        {"row " + id}
      </span>
    })
  ];
}

#f1 = ($0) => <for
  each={$0.each()}
>
  {$0.children()}
</for>

#f2 = () => #f0(() => ($0) => #f1($0))

root = #f2()
