cs.lift((() => {\n                        → cs`{\n  
const                                     → const 
__cs_names                                → names
 = cs.const(                              →  = 
[                                         → [
"zero"                                    → "zero"
,                                         → , 
"one"                                     → "one"
]                                         → ]
);                                        → ;
\n                                        → \n  
const                                     → const 
__cs_missing                              → missing
 = cs.const(                              →  = 
cs.index(                                 → 
cs.splice(                                →  [-semantic]
(table)                                   → $table
) satisfies                               →  [-semantic]
import("@backtickjs/core").ClientUnknown  → $table
,                                         → [
"nowhere"                                 → "nowhere"
)                                         → ]
 ??                                       →  ?? 
"gone"                                    → "gone"
);                                        → ;
\n                                        → \n  
return cs.const(                          → return 
cs.index(                                 → 
__cs_names                                → names
,                                         → [
1                                         → 1
)                                         → ]
 +                                        →  + 
"/"                                       → "/"
 +                                        →  + 
__cs_missing                              → missing
);                                        → ;
\n})())                                   → \n}`
