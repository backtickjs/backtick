cs.lift((() => {\n      → cs`{\n  
const                   → const 
__cs_names              → names
 = cs.const(            →  = 
[                       → [
"zero"                  → "zero"
,                       → , 
"one"                   → "one"
]                       → ]
);                      → ;
\n                      → \n  
const                   → const 
__cs_missing            → missing
 = cs.const(            →  = 
cs.receiver(            → 
cs.splice(              →  [-semantic]
(table)                 → $table
)                       →  [-semantic]
)                       → 
[                       → [
"nowhere"               → "nowhere"
]                       → ]
 ??                     →  ?? 
"gone"                  → "gone"
);                      → ;
\n                      → \n  
return cs.const(        → return 
cs.receiver(            → 
__cs_names              → names
)                       → 
[                       → [
1                       → 1
]                       → ]
 +                      →  + 
"/"                     → "/"
 +                      →  + 
__cs_missing            → missing
);                      → ;
\n})())                 → \n}`
