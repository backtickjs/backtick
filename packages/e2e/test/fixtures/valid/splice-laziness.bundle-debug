#f0 = ($0, $1) => { "taken": $0()(true), "skipped": $1()(false) }

#f1 = ($0) => (flag) => {
  if (flag) {
    return $0(flag);
  }
  return "skipped";
}

#f2 = () => "evaluated"

#f3 = () => {
  throw "the guarded fragment must never evaluate";
}

root = #f0(() => #f1((flag) => #f2()), () => #f1((flag) => #f3()))
