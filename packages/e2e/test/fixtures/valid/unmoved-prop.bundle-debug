#f0 = ($0) => {
  const selected = state(0);
  return <div>
    {<span
      onclick={() => selected.write(1)}
    >
      {"select"}
    </span>}
    {<div>
      {$0()({
        "each": () => [0, 1, 2],
        "children": () => (id) => <a
          href={selected.read() === id ? "#open" : "#closed"}
        >
          {"row " + id}
        </a>
      })}
    </div>}
  </div>;
}

#f1 = ($0) => <for
  each={$0.each()}
>
  {$0.children()}
</for>

#f2 = () => #f0(() => ($0) => #f1($0))

root = #f2()
