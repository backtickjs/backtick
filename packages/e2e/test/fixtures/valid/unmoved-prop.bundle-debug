#f0 = ($0) => () => $0().write(1)

#f1 = () => [0, 1, 2]

#f2 = ($0) => (id) => $0(id)

#f3 = ($0, $1) => $0($1).read() === $1 ? "#open" : "#closed"

#f4 = ($0) => "row " + $0

#f5 = (id, s0) => <a
  href={#f3((id) => s0, id)}
>
  {#f4(id)}
</a>

#f6 = () => {
  const s0 = state(0);
  return <div>
    {<span
      onclick={#f0(() => s0)}
    >
      {"select"}
    </span>}
    {<div>
      {<for
        each={#f1()}
      >
        {#f2((id) => #f5(id, s0))}
      </for>}
    </div>}
  </div>;
}

root = #f6()
