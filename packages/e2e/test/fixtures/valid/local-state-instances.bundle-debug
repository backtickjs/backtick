#f0 = ($0) => $0().read()

#f1 = ($0) => () => {
  $0().write($0().read() + 1);
}

#f2 = () => {
  const s0 = state(16);
  return <Text
    style={{ "fontSize": #f0(() => s0) }}
    onPress={#f1(() => s0)}
  >
    {"press"}
  </Text>;
}

#f3 = () => {
  const s1 = state(16);
  return <Text
    style={{ "fontSize": #f0(() => s1) }}
    onPress={#f1(() => s1)}
  >
    {"press"}
  </Text>;
}

#f4 = () => <View>
  {#f2()}
  {#f3()}
</View>

root = #f4()
