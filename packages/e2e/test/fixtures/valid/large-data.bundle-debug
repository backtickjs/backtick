#f0 = ($0) => $0()

#f1 = ($0) => (order) => $0(order)

#f2 = ($0) => "https://img.example.com/" + $0.id + ".png"

#f3 = ($0) => $0.customer.name

#f4 = ($0) => $0.customer.city

#f5 = ($0) => $0.items

#f6 = ($0) => (item) => $0(item)

#f7 = ($0) => $0.sku + " x" + $0.qty

#f8 = ($0) => "$" + $0.total

#t0 = () => <Text>
  {#f7(slots[0])}
</Text>

#t1 = () => <View>
  {<Image
    source={{ "uri": #f2(slots[0]) }}
  />}
  {<Text>
    {#f3(slots[0])}
  </Text>}
  {<Text>
    {#f4(slots[0])}
  </Text>}
  {<For
    each={#f5(slots[0])}
  >
    {#f6((item) => #t0(item))}
  </For>}
  {<Text>
    {#f8(slots[0])}
  </Text>}
</View>

#t2 = () => <View>
  {<For
    each={#f0(() => [
      {
        "id": "ord-1000",
        "customer": { "name": "Customer 0", "city": "Montréal" },
        "items": [{ "sku": "SKU-0-A", "qty": 1 }, { "sku": "SKU-0-B", "qty": 1 }],
        "total": 45.23
      },
      {
        "id": "ord-1001",
        "customer": { "name": "Customer 1", "city": "Toronto" },
        "items": [{ "sku": "SKU-1-A", "qty": 2 }, { "sku": "SKU-1-B", "qty": 1 }],
        "total": 46.23
      },
      {
        "id": "ord-1002",
        "customer": { "name": "Customer 2", "city": "Montréal" },
        "items": [{ "sku": "SKU-2-A", "qty": 3 }, { "sku": "SKU-2-B", "qty": 1 }],
        "total": 47.23
      },
      {
        "id": "ord-1003",
        "customer": { "name": "Customer 3", "city": "Toronto" },
        "items": [{ "sku": "SKU-3-A", "qty": 1 }, { "sku": "SKU-3-B", "qty": 1 }],
        "total": 48.23
      },
      {
        "id": "ord-1004",
        "customer": { "name": "Customer 4", "city": "Montréal" },
        "items": [{ "sku": "SKU-4-A", "qty": 2 }, { "sku": "SKU-4-B", "qty": 1 }],
        "total": 49.23
      }
    ])}
  >
    {#f1((order) => #t1(order))}
  </For>}
</View>

root = #t2()
