#f0 = ($0) => $0().read()

#f1 = ($0) => $0()(1)

#f2 = () => (from) => {
  return Array.from({ "length": 3 }, (_, at) => {
    return { "id": from + at, "label": state("row " + from + at) };
  });
}

#f3 = () => (row) => <li
  onclick={() => row.label.write("pressed")}
>
  {row.label.read()}
</li>

#f4 = () => {
  const s0 = state(#f1(#f2));
  return <div>
    {<ul
      class={"rows"}
    >
      {<for
        each={#f0(() => s0)}
      >
        {#f3()}
      </for>}
    </ul>}
  </div>;
}

root = #f4()
