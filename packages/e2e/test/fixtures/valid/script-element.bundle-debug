#f0 = () => {
  const label = state("hi");
  const row = (size) => {
    const css = "font-size: " + size + "px";
    const press = () => label.write("held");
    return <div
      style={css}
    >
      {<span
        style={css}
        onclick={() => label.write("pressed")}
      >
        {label.read()}
      </span>}
      {<span
        style={"font-size: 8px"}
      >
        {"fixed"}
      </span>}
      {<span
        style={css}
        onclick={press}
      >
        {"held"}
      </span>}
    </div>;
  };
  return <div
    style={"padding: 0"}
  >
    {row(12)}
  </div>;
}

root = #f0()
