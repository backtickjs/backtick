#f0 = ($0) => $0()(12)

#f1 = ($0) => (size) => {
  const press = () => $0().write("held");
  return <View
    style={{ "padding": size }}
  >
    {<Text
      style={{ "fontSize": size }}
      onPress={() => $0().write("pressed")}
    >
      {$0().read()}
    </Text>}
    {<Text
      style={{ "fontSize": 8 }}
    >
      {"fixed"}
    </Text>}
    {<Text
      style={{ "fontSize": size }}
      onPress={press}
    >
      {"held"}
    </Text>}
  </View>;
}

#f2 = () => {
  const s0 = state("hi");
  return <View
    style={{ "padding": 0 }}
  >
    {#f0(() => #f1(() => s0))}
  </View>;
}

root = #f2()
