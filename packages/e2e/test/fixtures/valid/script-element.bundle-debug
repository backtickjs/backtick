#f0 = ($0) => $0()(12)

#f1 = ($0) => (size) => {
  const css = "font-size: " + size + "px";
  const press = () => $0().write("held");
  return <div
    style={css}
  >
    {<span
      style={css}
      onclick={() => $0().write("pressed")}
    >
      {$0().read()}
    </span>}
    {<span
      style={"font-size: 8px"}
    >
      {"fixed"}
    </span>}
    {<span
      style={css}
      onclick={press}
    >
      {"held"}
    </span>}
  </div>;
}

#f2 = () => {
  const s0 = state("hi");
  return <div
    style={"padding: 0"}
  >
    {#f0(() => #f1(() => s0))}
  </div>;
}

root = #f2()
