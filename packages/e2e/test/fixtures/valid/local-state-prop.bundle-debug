#f0 = ($0) => {
  const size = state(16);
  return <div>
    {$0()({ "size": () => size })}
    {$0()({ "size": () => size })}
  </div>;
}

#f1 = ($0) => "font-size: " + $0().read() + "px"

#f2 = ($0) => () => {
  $0().write($0().read() + 1);
}

#f3 = ($0) => <span
  style={#f1(() => $0.size())}
  onclick={#f2(() => $0.size())}
>
  {"press"}
</span>

root = #f0(() => ($0) => #f3($0))
