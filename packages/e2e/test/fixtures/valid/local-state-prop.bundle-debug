#f0 = ($0) => $0().read()

#f1 = ($0) => () => {
  $0().write($0().read() + 1);
}

#f2 = (s0) => <Text
  style={{ "fontSize": #f0(() => s0) }}
  onPress={#f1(() => s0)}
>
  {"press"}
</Text>

#f3 = (s0) => <Text
  style={{ "fontSize": #f0(() => s0) }}
  onPress={#f1(() => s0)}
>
  {"press"}
</Text>

#f4 = () => {
  const s0 = state(16);
  return <View>
    {#f2(s0)}
    {#f3(s0)}
  </View>;
}

root = #f4()
