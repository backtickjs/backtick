#f0 = ($0) => $0().read()

#f1 = ($0) => () => {
  $0().write($0().read() + 1);
}

#t0 = (s0) => <Text
  style={{ "fontSize": #f0(() => s0) }}
  onPress={#f1(() => s0)}
>
  {"press"}
</Text>

#t1 = (s0) => <Text
  style={{ "fontSize": #f0(() => s0) }}
  onPress={#f1(() => s0)}
>
  {"press"}
</Text>

#t2 = () => {
  const s0 = state(16);
  return <View>
    {#t0(s0)}
    {#t1(s0)}
  </View>;
}

root = #t2()
