#f0 = ($0) => "font-size: " + $0().read() + "px"

#f1 = ($0) => () => {
  $0().write($0().read() + 1);
}

#f2 = (s0) => <span
  style={#f0(() => s0)}
  onclick={#f1(() => s0)}
>
  {"press"}
</span>

#f3 = (s0) => <span
  style={#f0(() => s0)}
  onclick={#f1(() => s0)}
>
  {"press"}
</span>

#f4 = () => {
  const s0 = state(16);
  return <div>
    {#f2(s0)}
    {#f3(s0)}
  </div>;
}

root = #f4()
