#f0 = ($0, $1, $2) => {
  const held = $0()($1().Red);
  return <span
    onclick={() => held.write($1().Blue)}
  >
    {$2()(held.read())}
  </span>;
}

#f1 = ($0) => (c) => {
  return c === $0().Blue ? "blue" : "red";
}

root = #f0(() => state, () => { "0": "Red", "1": "Blue", "Red": 0, "Blue": 1 }, () => #f1(() => { "0": "Red", "1": "Blue", "Red": 0, "Blue": 1 }))
