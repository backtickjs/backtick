#f0 = () => {
  const count = state(0);
  return <button
    id={"row"}
    style={"display: flex; gap: 8px"}
    onclick={() => count.write(count.read() + 1)}
  >
    {<span
      style={"font-weight: 700"}
    >
      {count.read() > 0 ? "☑" : "☐"}
    </span>}
    {<span>
      {"pressed " + count.read() + " times"}
    </span>}
  </button>;
}

root = #f0()
