#f0 = ($0) => () => $0().write($0().read() + 1)

#f1 = ($0) => $0().read() > 0 ? "☑" : "☐"

#f2 = ($0) => "pressed " + $0().read() + " times"

#f3 = () => {
  const s0 = state(0);
  return <button
    id={"row"}
    style={"display: flex; gap: 8px"}
    onclick={#f0(() => s0)}
  >
    {<span
      style={"font-weight: 700"}
    >
      {#f1(() => s0)}
    </span>}
    {<span>
      {#f2(() => s0)}
    </span>}
  </button>;
}

root = #f3()
