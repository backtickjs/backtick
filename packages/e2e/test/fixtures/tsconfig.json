{
  // Editor-only project, never built: gives tsserver the same options the
  // typecheck suite's in-memory program uses, so fixtures opened in the
  // extension development host resolve JSX through @backtickjs/core.
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@backtickjs/core",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  }
}
