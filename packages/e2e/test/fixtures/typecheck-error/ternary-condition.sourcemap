cs.lift(cs.const(   → cs`
1                   → 1
))                  → `
cs.lift(cs.const(   → cs`
(cs.condition(      → 
cs.splice(          →  [-semantic]
(count)             → $count
)                   →  [-semantic]
) &&                → 
cs.splice((count))  → $count [-semantic -completion -navigation -verification]
) ?                 →  ? 
"some"              → "some"
 :                  →  : 
"none"              → "none"
))                  → `
