cs.lift(cs.const(                → cs`
(                                → (
__cs_name                        → name
: string | null                  → ?: string
) => {\n                         → ) => {\n  
return                           → return 
(                                → 
cs.receiver(                     → 
__cs_name                        → name
)                                → 
?.                               → ?.
concat                           → concat
(                                → (
"!"                              → "!"
) ?? null)                       → )
;                                → ;
\n}                              → \n}
))                               → `
cs.lift(cs.const((() => {\n      → cs`{\n  
return                           → return 
cs.splice(                       →  [-semantic]
(greet)                          → $greet
)                                →  [-semantic]
()                               → ()
;                                → ;
\n})()))                         → \n}`
