cs.lift(cs.const(    → cs`
(                    → (
__cs_count           → count
: number             → : number
,                    → , 
__cs_flag            → flag
: boolean            → : boolean
) => {\n             → ) => {\n  
return cs.const(     → return 
(cs.condition(       → (
__cs_count           → count
) &&                 → 
__cs_count           → count [-semantic -completion -navigation -verification]
) && (cs.condition(  →  && 
__cs_flag            → flag
) &&                 → 
__cs_flag            → flag [-semantic -completion -navigation -verification]
)                    → )
 || (cs.condition(   →  || 
"none"               → "none"
) &&                 → 
"none"               → "none" [-semantic -completion -navigation -verification]
)                    → 
);                   → ;
\n}                  → \n}
))                   → `
