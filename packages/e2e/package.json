{
  "name": "@backtickjs/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "test": "node --conditions=browser --test \"test/**/*.test.ts\"",
    "test:update": "UPDATE_SNAPSHOTS=1 node --conditions=browser --test \"test/**/*.test.ts\"",
    "clean": "rm -rf node_modules .cache .turbo"
  },
  "devDependencies": {
    "@backtickjs/compiler": "workspace:*",
    "@backtickjs/core": "workspace:*",
    "@backtickjs/cs-runtime": "workspace:*",
    "@backtickjs/js-interpreter": "workspace:*",
    "@backtickjs/prettier-plugin": "workspace:*",
    "@backtickjs/tsc": "workspace:*",
    "@backtickjs/web-sdk": "workspace:*",
    "prettier": "^3.6.2",
    "solid-js": "^1.9.14",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "plugins": [
      "@backtickjs/prettier-plugin"
    ]
  }
}
