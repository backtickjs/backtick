{
  "name": "@backtickjs/react-native-client",
  "version": "0.1.0",
  "private": true,
  "description": "What a React Native app draws a Backtick server's screens with: a bundle fetched, run with the app's own packages, and drawn",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "peerDependencies": {
    "react": "^19.2.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "prettier": "^3.6.2",
    "react": "19.2.3",
    "typescript": "^6.0.3"
  }
}
