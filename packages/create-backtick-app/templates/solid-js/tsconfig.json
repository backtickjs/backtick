{
  "compilerOptions": {
    // Imports kept as written: a name a page only splices, as `$onMount`, looks
    // unused to TypeScript, which would otherwise drop its import.
    "verbatimModuleSyntax": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "@backtickjs/solid-js"
  },
  "include": ["server"]
}
