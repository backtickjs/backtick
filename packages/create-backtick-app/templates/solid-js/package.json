{
  "name": "backtick-app-solid-js",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "nodemon --exec \"node --enable-source-maps --import @backtickjs/node-plugin server/index.tsx\"",
    "reset-project": "node scripts/reset-project.mjs",
    "typecheck": "backtick-tsc --noEmit",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown ."
  },
  "dependencies": {
    "@backtickjs/bundler": "^0.2.0",
    "@backtickjs/core": "^0.2.0",
    "@backtickjs/node-plugin": "^0.2.0",
    "@backtickjs/jsx-solid": "^0.2.0",
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "solid-js": "1.9.17",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@backtickjs/prettier-plugin": "^0.2.0",
    "@backtickjs/tsc": "^0.2.0",
    "@types/node": "^25.9.1",
    "agent-device": "^0.21.27",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.2"
  },
  "nodemonConfig": {
    "watch": [
      "server"
    ],
    "ext": "ts,tsx"
  },
  "backtick": {
    "plugins": [
      "@backtickjs/jsx-solid/plugin"
    ]
  }
}
