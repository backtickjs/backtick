{
  "compilerOptions": {
    // Imports kept as written: a name a screen only splices, as `$View`, looks
    // unused to TypeScript, which would otherwise drop its import.
    "verbatimModuleSyntax": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "@backtickjs/react"
  },
  "include": ["."]
}
