{
  "name": "backtick-app-react-native",
  "version": "1.0.0",
  "private": true,
  "main": "client/index.ts",
  "scripts": {
    "server": "nodemon --exec \"node --enable-source-maps --import @backtickjs/node-plugin server/index.tsx\"",
    "start": "concurrently --raw --kill-others npm:server \"expo start\"",
    "android": "concurrently --raw --kill-others npm:server \"expo start --android\"",
    "ios": "concurrently --raw --kill-others npm:server \"expo start --ios\"",
    "web": "concurrently --raw --kill-others npm:server \"expo start --web\"",
    "typecheck": "tsc --noEmit && backtick-tsc -p server --noEmit",
    "test": "node --import ./server/test/setup.mjs --import @backtickjs/node-plugin --test \"server/**/*.test.tsx\"",
    "reset-project": "node scripts/reset-project.mjs",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown ."
  },
  "dependencies": {
    "@backtickjs/builds": "^0.2.0",
    "@backtickjs/bundler": "^0.2.0",
    "@backtickjs/core": "^0.2.0",
    "@backtickjs/node-plugin": "^0.2.0",
    "@backtickjs/jsx-react": "^0.2.0",
    "@hono/node-server": "^2.1.4",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "hono": "^4.13.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "6.1.6",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@backtickjs/prettier-plugin": "^0.2.0",
    "@backtickjs/tsc": "^0.2.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.1",
    "@types/react": "19.2.18",
    "agent-device": "^0.21.27",
    "concurrently": "^10.0.6",
    "global-jsdom": "^30.0.0",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.2"
  },
  "nodemonConfig": {
    "watch": [
      "server"
    ],
    "ext": "ts,tsx",
    "events": {
      "start": "node scripts/reload-expo.mjs"
    }
  },
  "backtick": {
    "plugins": [
      "@backtickjs/jsx-react/plugin"
    ]
  }
}
