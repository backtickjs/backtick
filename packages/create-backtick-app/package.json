{
  "name": "create-backtick-app",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Creates a React Native app whose screens come from your server, with Backtick",
  "type": "module",
  "bin": {
    "create-backtick-app": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/prompts": "^2.4.9",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "prompts": "^2.4.2"
  }
}
