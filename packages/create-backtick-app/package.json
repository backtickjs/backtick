{
  "name": "create-backtick-app",
  "version": "0.1.0",
  "description": "Creates a Backtick app: React Native, React or Solid, with screens from your server on Node or Bun",
  "keywords": [
    "backtick",
    "react-native",
    "server-driven-ui",
    "server-components",
    "create",
    "starter",
    "template",
    "expo",
    "react",
    "solid"
  ],
  "homepage": "https://backtickjs.com",
  "bugs": {
    "url": "https://github.com/backtickjs/backtick/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backtickjs/backtick.git",
    "directory": "packages/create-backtick-app"
  },
  "license": "MIT",
  "author": "Jean-François Bisson <jf@backtickjs.com>",
  "type": "module",
  "bin": {
    "create-backtick-app": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/prompts": "^2.4.9",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "prompts": "^2.4.2"
  }
}
