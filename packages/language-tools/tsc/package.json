{
  "name": "@backtickjs/tsc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "backtick-tsc": "./bin/backtick-tsc.js"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo"
  },
  "dependencies": {
    "@backtickjs/compiler": "workspace:*",
    "@backtickjs/language-service": "workspace:*",
    "@backtickjs/language-plugin": "workspace:*",
    "@volar/typescript": "^2.4.28"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
