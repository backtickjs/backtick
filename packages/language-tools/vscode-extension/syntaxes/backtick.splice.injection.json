{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Backtick Splice",
  "scopeName": "backtick.splice.injection",
  "injectionSelector": "L:source.backtick meta.embedded.backtick -comment",
  "patterns": [{ "include": "#splice" }],
  "repository": {
    "splice": {
      "name": "meta.embedded.splice.tsx",
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.splice.begin.tsx" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.splice.end.tsx" }
      },
      "patterns": [
        { "include": "backtick.template.injection#template" },
        { "include": "source.tsx" }
      ]
    }
  }
}
