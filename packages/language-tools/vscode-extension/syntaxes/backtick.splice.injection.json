{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Backtick Splice",
  "scopeName": "backtick.splice.injection",
  "injectionSelector": "L:source.backtick -comment -string",
  "patterns": [
    {
      "include": "#splice"
    }
  ],
  "repository": {
    "splice": {
      "name": "meta.template.expression.tsx",
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.tsx"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.tsx"
        }
      },
      "patterns": [
        {
          "include": "backtick.template.injection#template"
        },
        {
          "include": "source.tsx"
        }
      ]
    }
  }
}