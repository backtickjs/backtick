{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Backtick Splice",
  "scopeName": "backtick.splice",
  "injectionSelector": "L:backtick.tsx -comment -string",
  "patterns": [
    {
      "include": "#splice"
    }
  ],
  "repository": {
    "splice": {
      "name": "meta.template.expression.tsx",
      "contentName": "meta.embedded.splice.tsx",
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.tsx"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.tsx"
        }
      },
      "patterns": [
        {
          "include": "backtick.tsx#expression"
        }
      ]
    }
  }
}