{
  "name": "@backtick/vscode-extension",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/node/client.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onLanguage:backtick"
  ],
  "contributes": {
    "languages": [
      {
        "id": "backtick",
        "aliases": [
          "Backtick"
        ],
        "extensions": [
          ".bt"
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc -b && node scripts/build.mjs -- --minify",
    "dev": "node scripts/build.mjs -- --watch"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@volar/language-server": "^2.4.28",
    "@volar/vscode": "^2.4.28",
    "esbuild": "^0.28.0",
    "esbuild-plugin-copy": "^2.1.1",
    "kleur": "^4.1.5"
  }
}