{
  "name": "@backtick/vscode-extension",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/node/client.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "backtick",
        "aliases": [
          "Backtick"
        ],
        "extensions": [
          ".bt"
        ],
        "configuration": "./languages/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "backtick",
        "scopeName": "source.backtick",
        "path": "./syntaxes/backtick.json",
        "embeddedLanguages": {
          "meta.embedded.backtick.tsx": "typescriptreact",
          "meta.embedded.splice.tsx": "typescriptreact"
        }
      }
    ]
  },
  "scripts": {
    "build": "tsc -b && node scripts/build.mjs -- --minify",
    "dev": "node scripts/build.mjs -- --watch",
    "build:grammar": "node scripts/build-grammar.mjs",
    "dev:grammar": "node scripts/build-grammar.mjs -- --watch",
    "test": "pnpm test:grammar",
    "test:update": "pnpm build:grammar && node ./test/grammar/test.mjs --updateSnapshot",
    "test:grammar": "pnpm build:grammar && node ./test/grammar/test.mjs"
  },
  "devDependencies": {
    "@backtick/language-server": "^0.0.0",
    "@types/vscode": "^1.120.0",
    "@volar/language-server": "^2.4.28",
    "@volar/vscode": "^2.4.28",
    "esbuild": "^0.28.0",
    "esbuild-plugin-copy": "^2.1.1",
    "kleur": "^4.1.5",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}