{
  "name": "@backtick/vscode-extension",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/node/client.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onLanguage:backtick"
  ],
  "contributes": {
    "languages": [
      {
        "id": "backtick",
        "aliases": [
          "Backtick"
        ],
        "extensions": [
          ".bt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "backtick",
        "scopeName": "source.backtick",
        "path": "./syntaxes/backtick.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.backtick.tsx": "typescriptreact",
          "meta.embedded.splice.tsx": "typescriptreact"
        }
      },
      {
        "scopeName": "backtick.template.injection",
        "path": "./syntaxes/backtick.template.injection.json",
        "injectTo": [
          "source.backtick"
        ]
      },
      {
        "scopeName": "backtick.splice.injection",
        "path": "./syntaxes/backtick.splice.injection.json",
        "injectTo": [
          "source.backtick"
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc -b && node scripts/build.mjs -- --minify",
    "dev": "node scripts/build.mjs -- --watch"
  },
  "devDependencies": {
    "@backtick/language-server": "^0.0.0",
    "@types/vscode": "^1.120.0",
    "@volar/language-server": "^2.4.28",
    "@volar/vscode": "^2.4.28",
    "esbuild": "^0.28.0",
    "esbuild-plugin-copy": "^2.1.1",
    "kleur": "^4.1.5"
  }
}