{
  "name": "@backtick/vscode-extension",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/node/client.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "contributes": {
    "grammars": [
      {
        "scopeName": "source.client-script.injection",
        "path": "./syntaxes/client-script.injection.json",
        "injectTo": [
          "source.ts",
          "source.tsx",
          "source.js",
          "source.js.jsx"
        ],
        "embeddedLanguages": {
          "meta.embedded.client-script.tsx": "typescriptreact"
        }
      },
      {
        "scopeName": "source.splice.injection",
        "path": "./syntaxes/splice.injection.json",
        "injectTo": [
          "source.ts",
          "source.tsx",
          "source.js",
          "source.js.jsx"
        ],
        "embeddedLanguages": {
          "meta.embedded.splice.tsx": "typescriptreact"
        }
      }
    ]
  },
  "scripts": {
    "build": "tsc -b && node scripts/build.mjs -- --minify",
    "dev": "node scripts/build.mjs -- --watch",
    "test": "pnpm test:grammar",
    "test:update": "node ./test/grammar/test.mjs --updateSnapshot",
    "test:grammar": "node ./test/grammar/test.mjs"
  },
  "dependencies": {
    "@backtick/prettier-plugin": "^0.0.0",
    "prettier": "^3.6.2"
  },
  "devDependencies": {
    "@backtick/language-server": "^0.0.0",
    "@types/vscode": "^1.120.0",
    "@volar/language-server": "^2.4.28",
    "@volar/vscode": "^2.4.28",
    "esbuild": "^0.28.0",
    "esbuild-plugin-copy": "^2.1.1",
    "kleur": "^4.1.5",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}