{
  "name": "@backtick/vscode-extension",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "contributes": {
    "typescriptServerPlugins": [
      {
        "name": "@backtick/ts-diagnostics-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      },
      {
        "name": "@backtick/ts-intellisense-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ],
    "grammars": [
      {
        "scopeName": "source.client-script.injection",
        "path": "./syntaxes/client-script.injection.json",
        "injectTo": [
          "source.ts",
          "source.tsx",
          "source.js",
          "source.js.jsx"
        ],
        "embeddedLanguages": {
          "meta.embedded.client-script.tsx": "typescriptreact"
        }
      },
      {
        "scopeName": "source.splice.injection",
        "path": "./syntaxes/splice.injection.json",
        "injectTo": [
          "source.ts",
          "source.tsx",
          "source.js",
          "source.js.jsx"
        ],
        "embeddedLanguages": {
          "meta.embedded.splice.tsx": "typescriptreact"
        }
      }
    ]
  },
  "scripts": {
    "build": "tsc -b",
    "test": "pnpm test:grammar",
    "test:update": "node ./test/grammar/test.mjs --updateSnapshot",
    "test:grammar": "node ./test/grammar/test.mjs",
    "clean": "rm -rf node_modules dist .turbo"
  },
  "dependencies": {
    "@backtick/ts-diagnostics-plugin": "workspace:*",
    "@backtick/ts-intellisense-plugin": "workspace:*"
  },
  "devDependencies": {
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
