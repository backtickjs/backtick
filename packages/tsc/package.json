{
  "name": "@backtickjs/tsc",
  "version": "0.1.3",
  "description": "backtick-tsc: tsc that type-checks Backtick client scripts and every splice crossing into them",
  "keywords": [
    "backtick",
    "react-native",
    "server-driven-ui",
    "server-components",
    "tsc",
    "typescript",
    "typecheck",
    "cli"
  ],
  "homepage": "https://backtickjs.com",
  "bugs": {
    "url": "https://github.com/backtickjs/backtick/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backtickjs/backtick.git",
    "directory": "packages/tsc"
  },
  "license": "MIT",
  "author": "Jean-François Bisson <jf@backtickjs.com>",
  "type": "module",
  "bin": {
    "backtick-tsc": "./bin/backtick-tsc.js"
  },
  "files": [
    "bin",
    "dist",
    "!dist/._cache",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@backtickjs/compiler": "workspace:*",
    "@backtickjs/language-service": "workspace:*",
    "@backtickjs/language-plugin": "workspace:*",
    "@volar/typescript": "^2.4.28"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
