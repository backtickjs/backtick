{
  "extends": "../../../configs/tsconfig.build.json",
  "compilerOptions": {
    "emitDeclarationOnly": false,
    // A browser's globals, and nothing else's: what is here is bundled into a
    // page, so reaching for `node:fs` is a mistake the types catch.
    "moduleResolution": "bundler",
    "module": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": []
  }
}
