{
  "name": "@backtickjs/language-service",
  "version": "0.1.0",
  "private": true,
  "description": "Internal: used by `@backtickjs/tsc` and the TypeScript plugin. Backtick's diagnostics and completions on top of TypeScript's",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@backtickjs/compiler": "workspace:*",
    "@backtickjs/language-plugin": "workspace:*",
    "@volar/language-core": "^2.4.28"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
