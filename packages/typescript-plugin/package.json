{
  "name": "@backtickjs/typescript-plugin",
  "version": "0.1.0",
  "description": "Internal: the tsserver plugin that type-checks Backtick client scripts in your editor",
  "keywords": [
    "backtick",
    "react-native",
    "server-driven-ui",
    "server-components",
    "typescript",
    "tsserver",
    "tsserver-plugin",
    "language-tools"
  ],
  "homepage": "https://backtickjs.com",
  "bugs": {
    "url": "https://github.com/backtickjs/backtick/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backtickjs/backtick.git",
    "directory": "packages/typescript-plugin"
  },
  "license": "MIT",
  "author": "Jean-François Bisson <jf@backtickjs.com>",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/._cache",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "test": "node --test \"test/**/*.test.ts\"",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@backtickjs/language-plugin": "workspace:*",
    "@backtickjs/language-service": "workspace:*",
    "@volar/language-core": "^2.4.28",
    "@volar/typescript": "^2.4.28"
  },
  "devDependencies": {
    "@backtickjs/core": "workspace:*",
    "@backtickjs/solid-js": "workspace:*",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
