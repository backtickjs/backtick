{
  "name": "@backtickjs/typescript-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Internal: used by the VS Code extension. The tsserver plugin for `cs` scripts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo"
  },
  "dependencies": {
    "@backtickjs/language-plugin": "workspace:*",
    "@backtickjs/language-service": "workspace:*",
    "@volar/language-core": "^2.4.28",
    "@volar/typescript": "^2.4.28"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
