{
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@backtickjs/cardputer-schema",
    "plugins": [{ "transform": "@backtickjs/tspatch-plugin" }]
  },
  "include": ["src"]
}
