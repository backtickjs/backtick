# The host build.
build/

# ESP-IDF's, and the components it fetches. Both are derived: `idf.py build`
# makes them, and `idf_component.yml` says which versions.
firmware/build/
firmware/managed_components/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/dependencies.lock

# The app, compiled. `bundle.json` is checked in because the firmware embeds it
# and a build without one does not link — it is the app, not a build artifact.
app/dist/
