// No project here references another. Turbo orders the graph from
// `package.json`, and what a reference adds beyond that is resolving imports to
// another package's sources — which would mean compiling them with this
// package's compiler.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "strict": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "nodenext",
    "target": "esnext",
    "module": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "stripInternal": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Emit declaration and cache files to a directory that would be ignored by tools like Git and ESLint.
    "outDir": "${configDir}/node_modules/.cache/ts_base/out",
    "types": ["node"]
  }
}
