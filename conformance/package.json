{
  "name": "@backtickjs/conformance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JavaScript's own answers, mined from Test262, as one assertion per file",
  "scripts": {
    "build": "echo 'conformance has nothing to build'",
    "curate": "node --experimental-vm-modules --no-warnings test262/curate.mjs",
    "test": "node --experimental-vm-modules --no-warnings --test \"*.test.mjs\""
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
