{
  "name": "@backtickjs/react-error-boundary",
  "version": "6.1.6",
  "description": "The react-error-boundary adapter for Backtick: `react-error-boundary`'s component, hook and HOC as client values your scripts splice",
  "keywords": [
    "backtick",
    "error-boundary",
    "server-driven-ui",
    "adapter"
  ],
  "homepage": "https://backtickjs.com",
  "bugs": {
    "url": "https://github.com/backtickjs/backtick/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backtickjs/backtick.git",
    "directory": "adapters/react-error-boundary"
  },
  "license": "MIT",
  "author": "Jean-François Bisson <jf@backtickjs.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/._cache",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "backtick-tsc -p tsconfig.build.json --noEmit",
    "build": "tsc -b --force",
    "dev": "tsc -b --watch",
    "test": "node --test \"test/**/*.test.ts\"",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@backtickjs/core": "^0.1.11",
    "react-error-boundary": "6.1.6"
  },
  "devDependencies": {
    "@backtickjs/prettier-plugin": "^0.1.11",
    "@backtickjs/tsc": "^0.1.11",
    "@types/react": "19.2.18",
    "prettier": "^3.6.2",
    "react": "19.2.3",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "plugins": [
      "@backtickjs/prettier-plugin"
    ]
  }
}
