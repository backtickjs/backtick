{
  "name": "@backtickjs/react-native-safe-area-context",
  "version": "5.7.0",
  "description": "The React Native Safe Area Context adapter for Backtick: `react-native-safe-area-context`'s components and hooks as client values your scripts splice",
  "keywords": [
    "backtick",
    "react-native-safe-area-context",
    "safe-area",
    "react-native",
    "server-driven-ui",
    "adapter"
  ],
  "homepage": "https://backtickjs.com",
  "bugs": {
    "url": "https://github.com/backtickjs/backtick/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backtickjs/backtick.git",
    "directory": "adapters/react-native-safe-area-context"
  },
  "license": "MIT",
  "author": "Jean-François Bisson <jf@backtickjs.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/._cache",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "backtick-tsc -p tsconfig.build.json --noEmit",
    "build": "tspc -b --noCheck --force",
    "dev": "tspc -b --noCheck --watch",
    "test": "node --test \"test/**/*.test.ts\"",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@backtickjs/core": "^0.1.10",
    "react-native-safe-area-context": "5.7.0"
  },
  "devDependencies": {
    "@backtickjs/compiler": "^0.1.10",
    "@backtickjs/prettier-plugin": "^0.1.10",
    "@backtickjs/tsc": "^0.1.10",
    "@backtickjs/tspatch-plugin": "^0.1.10",
    "@types/react": "19.2.18",
    "prettier": "^3.6.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "ts-patch": "^4.0.1",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "plugins": [
      "@backtickjs/prettier-plugin"
    ]
  }
}
