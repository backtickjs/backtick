{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // The app is a package of its own rather than a dependency of this one, so
    // what this suite compiles against — the `Main` its `dist` holds — is named
    // here instead of coming from `^build`.
    //
    // `outputs`, because a task whose outputs are undeclared is one a cache hit
    // restores nothing of: the build is skipped and `test/bundle.js` stays as
    // it was, or missing.
    "build": {
      "dependsOn": ["js-framework-benchmark-backtick#build"],
      "outputs": ["test/bundle.js"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test:update": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
