{
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@backtickjs/web",
    "plugins": [
      { "transform": "@backtickjs/tspatch-plugin" }
    ]
  },
  "include": ["src"],
  "exclude": ["src/main.ts"]
}
