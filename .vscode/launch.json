{
  "version": "0.0.0",
  "configurations": [
    {
      "name": "Launch Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "${workspaceRoot}/examples/node-minimal",
        "--extensionDevelopmentPath=${workspaceRoot}/packages/language-tools/vscode-extension"
      ],
      "outFiles": ["${workspaceRoot}/*/*/dist/**/*.js"]
    }
  ]
}
