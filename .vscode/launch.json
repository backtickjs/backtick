{
  "version": "0.0.0",
  "configurations": [
    {
      "name": "Launch Client",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "${workspaceRoot}/tests",
        "--extensionDevelopmentPath=${workspaceRoot}/apps/vscode-extension"
      ],
      "outFiles": ["${workspaceRoot}/*/*/dist/**/*.js"]
    },
    {
      "name": "Attach to Server",
      "type": "node",
      "request": "attach",
      "port": 6009,
      "restart": true,
      "outFiles": ["${workspaceRoot}/*/*/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Launch Extension",
      "configurations": ["Launch Client", "Attach to Server"]
    }
  ]
}
