    "clean": "rm -rf node_modules dist .turbo"
  },
  "dependencies": {
    "@backtickjs-internal/language-plugin": "workspace:*",
    "@volar/language-server": "^2.4.28",
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
