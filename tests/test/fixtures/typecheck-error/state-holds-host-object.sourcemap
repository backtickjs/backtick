) satisfies typeof cs.ClientUnknown  →  [-semantic]
)                                    → )
);                                   → ;
\n                                   → \n  
cs.statement(                        → 
cs.receiver(                         → 
__cs_held                            → held
)                                    → 
.                                    → .
write                                → write
(                                    → (
cs.splice(                           →  [-semantic]
(host)                               → $host
) satisfies typeof cs.ClientUnknown  →  [-semantic]
)                                    → )
);                                   → ;
\n})())                              → \n}`
