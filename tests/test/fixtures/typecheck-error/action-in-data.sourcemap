);                                   → ;
\n})())                              → \n}`
cs.lift((() => {\n                   → cs`{\n  
const                                → const 
__cs_list                            → list
 = cs.const(                         →  = 
cs.splice(                           → ${ [-semantic]
[action]                             → [action]
) satisfies typeof cs.ClientUnknown  → } [-semantic]
);                                   → ;
\n                                   → \n  
