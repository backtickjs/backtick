#f0 = ($0) => {
  const said = $0()("");
  return <form
    onsubmit={(event) => {
      event.preventDefault();
      said.write(event.type + " " + event.cancelable);
    }}
  >
    {<textarea
      oninput={(event) => said.write(event.currentTarget.value)}
    />}
    {<input
      oninput={(event) => said.write(event.currentTarget.value)}
    />}
    {<button
      onclick={(event) => said.write(event.clientX + " " + event.currentTarget.tagName)}
    >
      {said.read()}
    </button>}
  </form>;
}

root = #f0(() => state)
