#f0 = ($0) => {
  const twice = (Card) => <div>
    {<Card
      n={1}
    />}
    {<Card
      n={2}
    />}
  </div>;
  return <section>
    {<{$0()}
      title={() => "host"}
    />}
    {twice((props) => <i>
      {"row " + props.n}
    </i>)}
  </section>;
}

root = #f0(() => ($0) => <h2>
  {$0.title()}
</h2>)
