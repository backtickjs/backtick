cs.lift(cs.const(                    → cs`
() => {\n                            → () => {\n  
const                                → const 
__cs_tree                            → tree
 = cs.const(                         →  = 
cs.splice(                           → ${ [-semantic]
(<div />)                            → (<div />)
) satisfies typeof cs.ClientUnknown  → } [-semantic]
);                                   → ;
\n                                   → \n  
return cs.const(                     → return 
__cs_tree                            → tree
);                                   → ;
\n}                                  → \n}
))                                   → `
