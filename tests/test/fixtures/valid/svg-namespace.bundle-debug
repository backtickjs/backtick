#f0 = ($0, $1) => {
  const Dot = (props) => <circle
    cx={props.x}
    cy={"5"}
    r={"2"}
  >
    {<title>
      {"dot " + props.x}
    </title>}
  </circle>;
  return <div>
    {<a
      href={"/shapes"}
    >
      {"shapes"}
    </a>}
    {<svg
      viewBox={"0 0 30 10"}
      width={"120"}
    >
      {<{$0()} />}
      {<{$1()}
        each={() => [10, 20]}
      >
        {() => (x) => <Dot
          x={x}
        />}
      </{$1()}>}
      {<foreignObject
        x={"0"}
        y={"0"}
        width={"10"}
        height={"10"}
      >
        {<p>
          {"html again"}
        </p>}
      </foreignObject>}
    </svg>}
  </div>;
}

#f1 = () => <circle
  cx={"5"}
  cy={"5"}
  r={"4"}
  fill={"none"}
  stroke={"currentColor"}
/>

root = #f0(() => () => #f1(), () => ($0) => <for
  each={$0.each()}
>
  {$0.children()}
</for>)
