#f0 = ($0, $1, $2) => <div>
  {<{$2()}
    title={() => "host"}
  />}
  {$0()}
  {$1()}
</div>

#f1 = ($0, $1) => {
  const Card = (props) => <i>
    {$0() + props.n}
  </i>;
  return <p>
    {$1(Card)}
  </p>;
}

#f2 = () => "a"

#f3 = ($0) => <$0
  n={1}
/>

#f4 = () => "b"

root = #f0(() => #f1(#f2, #f3), () => #f1(#f4, #f3), () => ($0) => <h2>
  {$0.title()}
</h2>)
