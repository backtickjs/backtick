#f0 = () => "font-size: 16px"

#f1 = ($0) => () => {
  const row = $0()("one");
  row.label.write(row.label.read() + " !!!");
}

#f2 = ($0) => (label) => {
  return { "label": $0()(label) };
}

#f3 = ($0) => $0()("one").label.read()

root = <span
  style={#f0()}
  onclick={#f1(() => #f2(() => state))}
>
  {#f3(() => #f2(() => state))}
</span>
