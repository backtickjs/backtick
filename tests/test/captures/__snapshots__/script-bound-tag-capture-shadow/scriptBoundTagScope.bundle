(($d) => {
  const f1 = ($0) => {
    const twice = (Card) =>
      jsx("div", {
        get children() {
          return [() => jsx(Card, { n: 1 }), () => jsx(Card, { n: 2 })];
        },
      });
    return jsx("section", {
      get children() {
        return [
          () => jsx($0(), { title: () => "host" }),
          () =>
            twice((props) =>
              jsx("i", {
                get children() {
                  return "row " + props.n;
                },
              }),
            ),
        ];
      },
    });
  };
  return f1(
    () => ($0) =>
      jsx("h2", {
        get children() {
          return $0.title();
        },
      }),
  );
})([]);
