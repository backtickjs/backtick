(($d) => {
  const f1 = (() => {
    const $entry = ($0) => {
      const twice = (Card) => (
        <div>
          <Card n={1} />
          <Card n={2} />
        </div>
      );
      return (
        <section>
          <$0 title="host" />
          {twice((props) => (
            <i>{"row " + props.n}</i>
          ))}
        </section>
      );
    };
    return $entry;
  })();
  return f1(($0) =>
    jsx("h2", {
      children: () => $0.title,
    }),
  );
})([]);
