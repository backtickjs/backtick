(($d) => {
  const f1 = (() => {
    const $entry = ($0, $1) => {
      const twice = (Row) => (
        <ul>
          {$0(Row)}
          {$1(Row)}
        </ul>
      );
      return twice((p) => <li>{"row " + p.n}</li>);
    };
    return $entry;
  })();
  const f2 = (() => {
    const $entry = ($0) => <$0 n={1} />;
    return $entry;
  })();
  const f3 = (() => {
    const $entry = ($0) => <$0 n={2} />;
    return $entry;
  })();
  return f1(f2, f3);
})([]);
