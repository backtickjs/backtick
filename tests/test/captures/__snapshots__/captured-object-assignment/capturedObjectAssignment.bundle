(() => {
  const f1 = (() => {
    const $entry = ($0) => {
      const counter = {
        count: 0,
      };
      const bump = $0(counter);
      bump();
      bump();
      return counter.count;
    };
    return $entry;
  })();
  const f2 = (() => {
    const $entry = ($0) => () => {
      $0.count += 1;
    };
    return $entry;
  })();
  const $bundle = f1(f2);
  return $bundle;
})();
