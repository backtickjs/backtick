(($d) => {
  const f1 = (() => {
    const $entry = ($0) => $0();
    return $entry;
  })();
  const f2 = (() => {
    const $entry = ($0, $1) => $0() + $1();
    return $entry;
  })();
  const f3 = (() => {
    const $entry = () => 1;
    return $entry;
  })();
  const f4 = (() => {
    const $entry = () => 2;
    return $entry;
  })();
  return f1(() => f2(f3, f4));
})([]);
