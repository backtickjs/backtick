(() => {
  const f1 = (() => {
    const $entry = ($0) => $0().x + 1;
    return $entry;
  })();
  const f2 = (() => {
    const $entry = () => 1;
    return $entry;
  })();
  const f3 = (() => {
    const $entry = () => "origin";
    return $entry;
  })();
  const $bundle = f1(() => ({
    x: f2(),
    label: f3(),
  }));
  return $bundle;
})();
