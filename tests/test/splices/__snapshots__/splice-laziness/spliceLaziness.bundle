(() => {
  const f1 = (() => {
    const $entry = ($0, $1) => ({
      taken: $0()(true),
      skipped: $1()(false),
    });
    return $entry;
  })();
  const f2 = (() => {
    const $entry = ($0) => (flag) => {
      if (flag) {
        return $0();
      }
      return "skipped";
    };
    return $entry;
  })();
  const f3 = (() => {
    const $entry = () => "evaluated";
    return $entry;
  })();
  const f4 = (() => {
    const $entry = () => {
      throw "the guarded fragment must never evaluate";
    };
    return $entry;
  })();
  const $bundle = f1(
    () => f2(f3),
    () => f2(f4),
  );
  return $bundle;
})();
