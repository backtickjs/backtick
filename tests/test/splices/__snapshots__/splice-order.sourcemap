cs.lift(                              → cs`
{                                     → ({ 
a                                     → a
:                                     → : 
(cs.splice(                           →  [-semantic]
(count)                               → $count
) satisfies typeof cs.ClientUnknown)  →  [-semantic]
,                                     → , 
b                                     → b
:                                     → : 
(cs.splice(                           → ${ [-semantic]
++count                               → ++count
) satisfies typeof cs.ClientUnknown)  → } [-semantic]
 }                                    →  })
)                                     → `
