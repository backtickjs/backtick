(() => {
  const f1 = (() => {
    const $entry = ($0, $1) => $0() + $1();
    return $entry;
  })();
  const f2 = (() => {
    const $entry = ($0) => {
      const before = 1;
      const spliced = $0();
      const after = 2;
      return before + spliced + after;
    };
    return $entry;
  })();
  const f3 = (() => {
    const $entry = () => 10;
    return $entry;
  })();
  const f4 = (() => {
    const $entry = () => 20;
    return $entry;
  })();
  const $bundle = f1(
    () => f2(f3),
    () => f2(f4),
  );
  return $bundle;
})();
