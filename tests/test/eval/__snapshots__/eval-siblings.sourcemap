cs.lift(cs.const(                     → cs`
<                                     → <
em                                    → em
>{cs.lift(                            → >{
"from another bundle"                 → "from another bundle"
)}</                                  → }</
em                                    → em
>                                     → >
))                                    → `
cs.lift(cs.const(                     → cs`
<                                     → <
div                                   → div
>{cs.lift(                            → >\n      
<                                     → <
span                                  → span
>before</                             → >before</
span                                  → span
>                                     → >
)}{cs.lift(                           → \n      {
eval                                  → eval
(                                     → (
