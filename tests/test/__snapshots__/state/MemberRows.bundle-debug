#f0 = ($0, $1) => {
  const build = (from) => {
    return Array.from({ "length": 3 }, (_, at) => {
      return { "id": from + at, "label": $0()("row " + from + at) };
    });
  };
  const held = $0()(build(1));
  return <div>
    {<ul
      class={"rows"}
    >
      {<{$1()}
        each={() => held.read()}
      >
        {() => (row) => <li
          onclick={() => row.label.write("pressed")}
        >
          {row.label.read()}
        </li>}
      </{$1()}>}
    </ul>}
  </div>;
}

root = <{() => #f0(() => state, () => ($0) => <for
  each={$0.each()}
>
  {$0.children()}
</for>)} />
