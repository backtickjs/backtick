cs.lift((() =>   → cs`
<                → <
li               → li
>{               → >{
cs.splice(       →  [-semantic]
(label)          → $label
)                →  [-semantic]
}</              → }</
li               → li
>                → >
)())             → `
cs.lift((() =>   → cs`
<                → <
h1               → h1
>{               → >{
cs.splice(       →  [-semantic]
(text)           → $text
)                →  [-semantic]
}</              → }</
h1               → h1
>                → >
)())             → `
cs.lift((() =>   → cs`
<                → <
hr               → hr
 />              →  />
)())             → `
cs.lift((() =>   → cs`
cs.splice(       →  [-semantic -navigation]
Row              → Row
)                →  [-semantic -navigation]
(                →  [-semantic -navigation -verification]
{                → Row 
label            → label
:                → =
"a"              → "a"
 }               → 
)                →  label="a" /> [-semantic -navigation -verification]
)())             → `
cs.lift((() =>   → cs`
cs.splice(       →  [-semantic -navigation]
Title            → Title
)                →  [-semantic -navigation]
(                →  [-semantic -navigation -verification]
{                → Title 
text             → text
:                → =
"Week"           → "Week"
 }               → 
)                →  text="Week" /> [-semantic -navigation -verification]
)())             → `
cs.lift((() =>   → cs`
cs.splice(       →  [-semantic -navigation]
Rule             → Rule
)                →  [-semantic -navigation]
(                →  [-semantic -navigation -verification]
{}               → Rule
)                →  /> [-semantic -navigation -verification]
)())             → `
