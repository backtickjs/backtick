    const $entry = ($0, $1) => <$0 n={$1.get() + 1000} />;
    return $entry;
  })();
  const f6 = (() => {
    const $entry = ($0, $1, $2) => (
      <$0 each={[1, 2]}>{(m) => <$1 n={m * $2.get()} />}</$0>
