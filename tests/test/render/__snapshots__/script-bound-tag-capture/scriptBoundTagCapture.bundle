  })();
  return f1(
    () => state,
    (count, Badge) => f2(Badge, count),
    (count, Badge) => f3(f4, Badge, count),
    (count, Badge) =>
      jsx("section", {
        children: () => f5(Badge, count),
      }),
    (count, Badge) =>
      f6(
        ($0) =>
          jsx("for", {
            each: () => $0.each,
            children: () => $0.children,
          }),
        Badge,
        count,
      ),
  );
})([]);
