      return (
        <div>
          {$1(count, Badge)}
          {$2(count, Badge)}
          {$3(count, Badge)}
          {$4(count, Badge)}
          <button onclick={() => count.set(count.get() + 1)}>more</button>
        </div>
      );
    };
    return $entry;
  })();
  const f2 = (() => {
    const $entry = ($0, $1) => <$0 n={$1.get()} />;
    return $entry;
  })();
  const f3 = (() => {
    const $entry = ($0, $1, $2) => {
      const skipped = 10;
      return $0($1, $2);
