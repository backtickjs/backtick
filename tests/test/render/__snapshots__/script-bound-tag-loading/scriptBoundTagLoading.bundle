(($d) => {
  const f1 = (() => {
    const $entry = ($0, $1) => {
      const count = $0()(0);
      const drawn = $0()(null);
      const Badge = (props) => {
        const held = drawn.get();
        return held === null ? null : eval(held)(props);
      };
      return (
        <div>
          {drawn.get() === null ? (
            <i>loading</i>
          ) : (
            <Badge count={count.get()} />
          )}
          <button onclick={() => drawn.set($1())}>load</button>
          <button onclick={() => count.set(count.get() + 1)}>more</button>
        </div>
      );
    };
    return $entry;
  })();
  return f1(
    () => state,
    () =>
      '($d => {\n  const f1 = (() => {\nconst $entry = () => (props) => \u003cb>{"count " + props.count}\u003c/b>;\nreturn $entry;\n})();\n  return f1();\n})([])',
  );
})([]);
