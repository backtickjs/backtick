cs.lift(                          → cs`
() => {\n                         → () => {\n  
const                             → const 
__cs_tree                         → tree
 =                                →  = 
cs.splice(                        → ${ [-semantic]
(<div />)                         → (<div />)
 satisfies typeof cs.Spliceable)  → } [-semantic]
;                                 → ;
\n                                → \n  
return                            → return 
__cs_tree                         → tree
;                                 → ;
\n}                               → \n}
)                                 → `
cs.lift(                          → cs`
() => {\n                         → () => {\n  
const                             → const 
__cs_tree                         → tree
 =                                →  = 
cs.splice(                        → ${ [-semantic]
(<HeldRow />)                     → (<HeldRow />)
 satisfies typeof cs.Spliceable)  → } [-semantic]
;                                 → ;
\n                                → \n  
return                            → return 
