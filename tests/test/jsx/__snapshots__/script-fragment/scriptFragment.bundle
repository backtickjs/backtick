(($d) => {
  const f1 = ($0) => $0()("x");
  const f2 = () => (name) => [
    jsx("span", { children: "a sentence across lines" }),
    jsx("span", {
      get children() {
        return [() => name, " ", () => name];
      },
    }),
  ];
  return jsx("div", {
    get children() {
      return f1(f2);
    },
  });
})([]);
