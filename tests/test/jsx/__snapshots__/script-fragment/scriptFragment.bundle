(($d) => {
  const f1 = (() => {
    const $entry = ($0) => $0()("x");
    return $entry;
  })();
  const f2 = (() => {
    const $entry = () => (name) => (
      <>
        <span>a sentence across lines</span>
        <span>
          {name} {name}
        </span>
      </>
    );
    return $entry;
  })();
  return jsx("div", {
    children: () => f1(f2),
  });
})([]);
