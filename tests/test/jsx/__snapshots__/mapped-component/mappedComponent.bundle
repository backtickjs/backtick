(($d) => {
  const f1 = (() => {
    const $entry = ($0) => $0();
    return $entry;
  })();
  const f2 = (() => {
    const $entry = ($0) => (row) => $0(row);
    return $entry;
  })();
  const f3 = (() => {
    const $entry = ($0) => "row " + $0;
    return $entry;
  })();
  return jsx("div", {
    children: jsx("for", {
      each: () => f1(() => [1, 2, 3]),
      children: () =>
        f2((row) =>
          jsx("span", {
            children: () => f3(row),
          }),
        ),
    }),
  });
})([]);
