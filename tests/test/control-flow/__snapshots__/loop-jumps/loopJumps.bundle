(() => {
  const f1 = (() => {
    const $entry = () => {
      let out = "";
      for (let i = 0; i < 5; i = i + 1) {
        if (i === 1) {
          continue;
        }
        while (true) {
          out = out + i;
          break;
        }
        if (i === 3) {
          break;
        }
      }
      return out;
    };
    return $entry;
  })();
  const $bundle = f1();
  return $bundle;
})();
