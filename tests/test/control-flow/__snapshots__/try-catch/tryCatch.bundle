(($d) => {
  const f1 = (() => {
    const $entry = () => {
      const message = "boom";
      try {
        throw message;
      } catch (error) {
        if (error === message) {
          return "caught boom";
        }
        return "caught something else";
      }
    };
    return $entry;
  })();
  return f1();
})([]);
