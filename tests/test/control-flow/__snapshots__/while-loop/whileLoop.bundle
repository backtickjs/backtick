(($d) => {
  const f1 = (() => {
    const $entry = () => {
      let i = 0;
      let total = 0;
      while (i < 5) {
        total = total + i;
        if (i === 3) {
          return total;
        }
        i = i + 1;
      }
      return total;
    };
    return $entry;
  })();
  return f1();
})([]);
