cs.lift((() => {\n                → cs`{\n      
const                             → const 
__cs_names                        → names
 =                                →  = 
[                                 → [
"zero"                            → "zero"
,                                 → , 
"one"                             → "one"
]                                 → ]
;                                 → ;
\n                                → \n      
const                             → const 
__cs_missing                      → missing
 =                                →  = 
cs.splice(                        →  [-semantic]
(answers)                         → $answers
 satisfies typeof cs.Spliceable)  →  [-semantic]
[                                 → [
"nowhere"                         → "nowhere"
]                                 → ]
 ??                               →  ?? 
"gone"                            → "gone"
;                                 → ;
\n                                → \n      
return                            → return 
__cs_names                        → names
[                                 → [
1                                 → 1
]                                 → ]
 +                                →  + 
"/"                               → "/"
 +                                →  + 
__cs_missing                      → missing
;                                 → ;
\n})())                           → \n    }`
