(($d) => {
  const f1 = (() => {
    const $entry = ($0) => (currency) => {
      const table = $0();
      const asked = table[currency] ?? 0;
      const usd = table["usd"] ?? 0;
      return asked + usd;
    };
    return $entry;
  })();
  return f1(() => ({
    usd: 3,
    eur: 4,
  }));
})([]);
