(() => {
  const f1 = (() => {
    const $entry = () => {
      const held = {
        n: 1,
        q: "ada",
      };
      const written = Object.fromEntries(
        Object.entries(held).map((pair) => [pair[0], JSON.stringify(pair[1])]),
      );
      return written.n + " " + written.q;
    };
    return $entry;
  })();
  const $bundle = f1();
  return $bundle;
})();
