(() => {
  const f1 = (() => {
    const $entry = () => {
      const coins = [5, 31, 7];
      let total = 0;
      for (let i = 0; i < coins.length; i = i + 1) {
        total = total + coins[i];
      }
      return total;
    };
    return $entry;
  })();
  const $bundle = f1();
  return $bundle;
})();
