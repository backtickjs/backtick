(($d) => {
  const f1 = () => {
    return jsx("span", {
      get children() {
        return (
          "/at?q=" +
          encodeURIComponent("a b+c&d#é") +
          "&page=" +
          encodeURIComponent(2.5) +
          " " +
          decodeURIComponent("a%20b%2Bc%26d%23%C3%A9")
        );
      },
    });
  };
  return jsx(() => f1(), {});
})([]);
