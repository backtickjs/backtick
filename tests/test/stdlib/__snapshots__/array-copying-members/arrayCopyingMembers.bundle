(($d) => {
  const f1 = (() => {
    const $entry = () => {
      const rows = [3, 1, 2];
      const sorted = rows.toSorted((a, b) => a - b);
      const reversed = rows.toReversed();
      const spliced = rows.toSpliced(1, 1);
      const inserted = rows.toSpliced(1, 0, 9);
      return (
        sorted.join(",") +
        "|" +
        reversed.join(",") +
        "|" +
        spliced.join(",") +
        "|" +
        inserted.join(",") +
        "|" +
        rows.join(",")
      );
    };
    return $entry;
  })();
  return f1();
})([]);
