(() => {
  const f1 = (() => {
    const $entry = () => {
      const prices = {
        apple: 1,
        pear: 2,
      };
      return {
        values: Object.values(prices),
        holds: [Object.hasOwn(prices, "pear"), Object.hasOwn(prices, "plum")],
      };
    };
    return $entry;
  })();
  const $bundle = f1();
  return $bundle;
})();
