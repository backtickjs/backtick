{
  "name": "@backtickjs/tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "test": "node --import ./test/setup.ts --test $(node test/testFiles.ts)",
    "test:update": "node --import ./test/setup.ts --test --test-update-snapshots $(node test/testFiles.ts)",
    "clean": "rm -rf node_modules .cache .turbo"
  },
  "devDependencies": {
    "@backtickjs/bundler": "workspace:*",
    "@backtickjs/compiler": "workspace:*",
    "@backtickjs/core": "workspace:*",
    "@backtickjs/prettier-plugin": "workspace:*",
    "@backtickjs/solid-js": "workspace:^0.1.0",
    "@backtickjs/tsc": "workspace:*",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/user-event": "^14.6.7",
    "global-jsdom": "^30.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "solid-js": "1.9.14",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "plugins": [
      "@backtickjs/prettier-plugin"
    ]
  },
  "description": "The suites that run several packages together"
}
