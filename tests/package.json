{
  "name": "@backtickjs/tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "test": "node --import ./test/setup.ts --test --experimental-test-isolation=none $(node test/testFiles.ts)",
    "test:update": "node --import ./test/setup.ts --test --experimental-test-isolation=none --test-update-snapshots $(node test/testFiles.ts)",
    "clean": "rm -rf node_modules .cache .turbo"
  },
  "devDependencies": {
    "@backtickjs/bundler": "^0.1.11",
    "@backtickjs/compiler": "^0.1.11",
    "@backtickjs/core": "^0.1.11",
    "@backtickjs/prettier-plugin": "^0.1.11",
    "@backtickjs/react": "^19.2.3",
    "@backtickjs/solid-js": "^1.9.14",
    "@backtickjs/tsc": "^0.1.11",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "acme-ui": "^1.0.0",
    "global-jsdom": "^30.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.3",
    "solid-js": "1.9.14",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "plugins": [
      "@backtickjs/prettier-plugin"
    ]
  },
  "description": "The suites that run several packages together"
}
