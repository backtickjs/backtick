{
  "extends": "../configs/tsconfig.test.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@backtickjs/solid-js"
  },
  "include": [
    "test/**/*.mts",
    "test/**/*.mjs",
    "test/**/*.ts",
    "test/**/*.runtime.tsx",
    // A helper with a script in it, imported by `snapshotCase.ts`.
    "test/inRoot.tsx",
    "test/**/*.virtual.tsx"
  ],
  "exclude": [
    // What the `.tsx` tests compile to, recorded whole: its relative imports
    // point at files beside the test, not beside the snapshot.
    "test/**/__snapshots__/**"
  ]
}
