{
  "name": "api.backtickjs.com",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Backtick's service: the MCP server hosts connect to, sign-in for it, and each app's bundles for the phone",
  "scripts": {
    "dev": "node --env-file=.env.local scripts/dev.ts",
    "typecheck": "pnpm run build && tsc --noEmit && backtick-tsc -p web --noEmit",
    "test": "node --import @backtickjs/node-plugin --test \"test/**/*.test.ts\"",
    "format": "prettier --write src test scripts web/src",
    "format:check": "prettier --check src test scripts web/src",
    "clean": "rm -rf node_modules .builds web/dist",
    "build": "tspc -p web --noCheck"
  },
  "dependencies": {
    "@backtickjs/bundler": "^0.2.4",
    "@backtickjs/core": "^0.2.4",
    "@backtickjs/expo": "^0.2.4",
    "@backtickjs/jsx-react": "^0.2.4",
    "@backtickjs/jsx-solid": "^0.2.4",
    "@backtickjs/node-plugin": "^0.2.4",
    "@backtickjs/tsc": "^0.2.4",
    "@expo/vector-icons": "^15.1.1",
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/server": "2.3.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.117.2",
    "@types/node": "^25.9.1",
    "@types/react": "19.3.0",
    "@vercel/functions": "3.9.11",
    "@vercel/sandbox": "3.5.1",
    "expo": "~58.0.17",
    "expo-clipboard": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-linear-gradient": "~58.0.3",
    "expo-router": "~58.0.25",
    "hono": "^4.13.13",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "solid-js": "1.9.17",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "backtick": {
    "plugins": [
      "@backtickjs/jsx-react/plugin",
      "@backtickjs/expo/plugin"
    ]
  },
  "devDependencies": {
    "@backtickjs/tspatch-plugin": "^0.2.4",
    "supabase": "2.119.0",
    "ts-patch": "4.0.1"
  }
}
