{
  "name": "api.backtickjs.com",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Backtick's service: the MCP server hosts connect to, sign-in for it, and each app's bundles for the phone",
  "scripts": {
    "dev": "node --env-file=.env.local scripts/dev.ts",
    "typecheck": "pnpm run build && tsc --noEmit && backtick-tsc -p web --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "format": "prettier --write src test scripts web/src",
    "format:check": "prettier --check src test scripts web/src",
    "clean": "rm -rf node_modules .builds web/dist",
    "build": "tspc -p web --noCheck"
  },
  "dependencies": {
    "@backtickjs/bundler": "^0.2.4",
    "@backtickjs/core": "^0.2.4",
    "@backtickjs/jsx-solid": "^0.2.4",
    "@backtickjs/tsc": "^0.2.4",
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@supabase/supabase-js": "2.117.2",
    "@types/node": "^25.9.1",
    "@vercel/functions": "3.9.11",
    "@vercel/sandbox": "3.5.1",
    "hono": "^4.13.13",
    "jose": "6.2.12",
    "qrcode": "1.5.4",
    "shell": "^1.0.0",
    "solid-js": "1.9.17",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@backtickjs/tspatch-plugin": "^0.2.4",
    "@types/qrcode": "^1.5.6",
    "supabase": "2.119.0",
    "ts-patch": "4.0.1"
  }
}
