{
  "name": "@backtickjs.com/compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The parser this site compiles with, as a script a page fetches when somebody types",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bundle": {
      "types": "./dist/bundle.d.ts",
      "default": "./dist/bundle.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node build.mjs",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo"
  },
  "dependencies": {
    "@backtickjs-internal/compiler": "workspace:*",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
