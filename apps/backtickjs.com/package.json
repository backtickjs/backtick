{
  "name": "backtickjs.com",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write src content",
    "format:check": "prettier --check src content",
    "typecheck": "backtick-tsc --noEmit && backtick-tsc -p content/examples --noEmit",
    "test": "cd content/examples && node --no-warnings --import ./test/setup.ts --import @backtickjs/node-plugin --test 'test/**/*.test.tsx'",
    "test:update": "cd content/examples && UPDATE=1 node --no-warnings --import ./test/setup.ts --import @backtickjs/node-plugin --test 'test/**/*.test.tsx'",
    "build": "NODE_ENV=production bun src/build.ts",
    "start": "nodemon --ext ts,tsx,json,css,md --exec bun src/index.tsx",
    "clean": "rm -rf node_modules"
  },
  "dependencies": {
    "@backtickjs/bun-plugin": "^0.1.4",
    "@backtickjs/bundler": "^0.1.4",
    "@backtickjs/core": "^0.1.4",
    "@backtickjs/solid-js": "^1.9.14",
    "@backtickjs/vscode-extension": "^0.1.4",
    "@shikijs/colorized-brackets": "^4.5.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "diff": "^9.0.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@backtickjs/node-plugin": "^0.1.4",
    "@backtickjs/prettier-plugin": "^0.1.4",
    "@backtickjs/react": "^19.2.3",
    "@backtickjs/react-native": "^0.86.3",
    "@backtickjs/react-native-client": "^0.1.4",
    "@backtickjs/tsc": "^0.1.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.3.14",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^25.9.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "global-jsdom": "^30.0.0",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.3"
  },
  "backtick": {
    "plugins": [
      "@backtickjs/solid-js/plugin"
    ]
  }
}
