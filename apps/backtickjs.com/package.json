{
  "name": "backtickjs.com",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "backtick-tsc --noEmit",
    "build": "NODE_ENV=production bun src/build.ts",
    "start": "nodemon --ext ts,tsx,json,css --exec bun src/index.tsx",
    "clean": "rm -rf node_modules"
  },
  "dependencies": {
    "@backtickjs/bun-plugin": "^0.1.2",
    "@backtickjs/bundler": "^0.1.2",
    "@backtickjs/core": "^0.1.2",
    "@backtickjs/solid-js": "^1.9.14",
    "@backtickjs/vscode-extension": "^0.1.2",
    "@shikijs/colorized-brackets": "^4.5.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@backtickjs/prettier-plugin": "^0.1.2",
    "@backtickjs/tsc": "^0.1.2",
    "@types/bun": "^1.3.14",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.2"
  },
  "backtick": {
    "plugins": [
      "@backtickjs/solid-js/plugin"
    ]
  }
}
