{
  "name": "@backtickjs.com/schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "What this site's two halves agree on: the names its own client answers for",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime/index.d.ts",
      "default": "./dist/jsx-runtime/index.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime/index.d.ts",
      "default": "./dist/jsx-dev-runtime/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "generate": "backtick-generate src/schema.ts",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "clean": "rm -rf node_modules dist .turbo"
  },
  "dependencies": {
    "@backtickjs/language": "workspace:*",
    "@backtickjs/schema": "workspace:*",
    "@backtickjs/ui": "workspace:*",
    "@backtickjs/web-client": "workspace:*"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
