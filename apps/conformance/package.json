{
  "name": "@backtickjs/conformance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The page a client passes by drawing it: one row per case, judged by the client under test",
  "scripts": {
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "backtick-tsc --noEmit",
    "start": "bun src/index.tsx",
    "clean": "rm -rf node_modules dist"
  },
  "dependencies": {
    "@backtickjs/bun-plugin": "workspace:*",
    "@backtickjs/core": "workspace:*",
    "@backtickjs/ui-platform-sdk": "workspace:*",
    "@backtickjs/web-page": "workspace:*"
  },
  "devDependencies": {
    "@backtickjs/prettier-plugin": "workspace:*",
    "@backtickjs/tsc": "workspace:*",
    "@types/bun": "^1.3.14",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
