{
  "expo": {
    "name": "MyStoryJar",
    "slug": "mystoryjar",
    "scheme": "mystoryjar",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mystoryjar.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "v9wttpbfk9.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "n38lu8286q.skadnetwork"
          }
        ]
      }
    },
    "android": {
      "package": "com.mystoryjar.app",
      "permissions": ["android.permission.INTERNET"]
    },
    "plugins": [
      "@backtickjs/builds/expo",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "575486299994058",
          "clientToken": "b25536d7a54d9b924f5ef3f7eb47af42",
          "displayName": "MyStoryJar",
          "scheme": "fb575486299994058",
          "isAutoInitEnabled": true,
          "autoLogAppEventsEnabled": false,
          "advertiserIDCollectionEnabled": false,
          "iosUserTrackingPermission": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.239132102423-k72sa3ecn8l9k2ptvjjcn68lnvo0masi"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MyStoryJar adds the photos you choose to your stories.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1ebebe8d-15c2-41ac-954c-213543522989"
      }
    },
    "owner": "jbisson"
  }
}
