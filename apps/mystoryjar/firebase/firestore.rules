// The rules the emulators enforce: production's, as the Firebase console had
// them on 2026-10-12, less the read access two admin accounts had to every
// user's data. The server's Admin SDK isn't subject to them.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /feedback/{id} {      
      allow create: 
        if request.resource.data.author == request.auth.uid;
    }

    match /stories/{id} {
      allow read:
        if resource.data.author == request.auth.uid;
           
      allow delete:
        if resource.data.author == request.auth.uid;
           
      allow create, update: 
        if request.resource.data.author == request.auth.uid;
    }
    
    match /preferences/{uid} {
      allow read:
        if uid == request.auth.uid;
           
      allow write:
        if uid == request.auth.uid;
    }
  }
}
