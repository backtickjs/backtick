{
  "name": "@backtickjs/js-framework-benchmark",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Backtick's implementation for Stefan Krause's js-framework-benchmark, and the runs measured with it",
  "js-framework-benchmark": {
    "frameworkVersion": "0.1.0",
    "frameworkHomeURL": "https://backtickjs.com/",
    "language": "TypeScript",
    "customURL": "/dist"
  },
  "scripts": {
    "format": "prettier --write src scripts cli.mjs build.mjs runs.html",
    "format:check": "prettier --check src scripts cli.mjs build.mjs runs.html",
    "build": "tspc --noCheck --declaration && node build.mjs",
    "build-prod": "tspc --noCheck --declaration && node build.mjs",
    "typecheck": "backtick-tsc --noEmit",
    "clean": "rm -rf node_modules dist js-framework-benchmark",
    "start": "node cli.mjs start",
    "bench": "node cli.mjs bench",
    "isKeyed": "node cli.mjs isKeyed",
    "checkCSP": "node cli.mjs checkCSP",
    "results": "node cli.mjs results",
    "table": "node scripts/table.mjs && prettier --write runs.html"
  },
  "keywords": [
    "backtick"
  ],
  "homepage": "https://github.com/trybacktick/backtick",
  "repository": {
    "type": "git",
    "url": "https://github.com/trybacktick/backtick.git"
  },
  "dependencies": {
    "@backtickjs/bundler": "^0.1.0",
    "@backtickjs/core": "^0.1.0",
    "@backtickjs/solid-js": "^1.9.14",
    "@backtickjs/tspatch-plugin": "^0.1.0"
  },
  "devDependencies": {
    "@backtickjs/prettier-plugin": "^0.1.0",
    "@backtickjs/tsc": "^0.1.0",
    "ts-patch": "^4.0.1",
    "typescript": "^6.0.3"
  },
  "backtick": {
    "plugins": [
      "@backtickjs/solid-js/plugin"
    ]
  }
}
