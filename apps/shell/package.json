    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@react-three/fiber": "9.8.1",
    "@shikijs/colorized-brackets": "^4.5.0",
    "@shopify/react-native-skia": "2.14.0",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.0",
    "expo": "~58.0.23",
