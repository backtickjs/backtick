  "devDependencies": {
    "@backtickjs/prettier-plugin": "0.2.8",
    "@backtickjs/tsc": "0.2.8",
    "@backtickjs/tspatch-plugin": "0.2.8",
    "@types/node": "^25.9.1",
    "@types/react": "19.3.0",
    "prettier": "^3.6.2",
    "ts-patch": "4.0.1"
  },
  "backtick": {
    "plugins": [
      "@backtickjs/jsx-react/plugin",
