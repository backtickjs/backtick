{
  "name": "shell",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./modules": {
      "types": "./build/client/modules.d.ts",
      "default": "./build/client/modules.js"
    },
    "./screens": {
      "types": "./build/server/index.d.ts",
      "default": "./build/server/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "modules": [
        "build/client/modules.d.ts"
      ],
      "screens": [
        "build/server/index.d.ts"
      ]
    }
  },
  "description": "The Backtick app: sign in, see the apps your assistant made, and open them",
  "main": "expo-router/entry",
  "scripts": {
    "build:android": "taskpolicy -b pnpm dlx eas-cli build -p android --profile production-local --local",
    "start": "expo start",
    "android": "expo run:android",
    "build": "tspc -p tsconfig.server.json --noCheck",
    "postinstall": "[ -z \"$EAS_BUILD\" ] || turbo run build --filter=shell^...",
    "typecheck": "tsc --noEmit && backtick-tsc -p server --noEmit",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown ."
  },
  "dependencies": {
    "@backtickjs/core": "0.2.8",
    "@backtickjs/expo": "0.2.8",
    "@backtickjs/hono": "0.2.8",
    "@backtickjs/jsx-react": "0.2.8",
    "@backtickjs/vscode-extension": "0.2.8",
    "@expo/ui": "~58.0.27",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
