{
  "expo": {
    "name": "Backtick",
    "slug": "backtick",
    "scheme": "backtick",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.backtickjs.app"
    },
    "android": {
      "package": "com.backtickjs.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "*.backtickjs.app" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#181818"
      }
    },
    "plugins": [
      "@backtickjs/expo",
      [
        "expo-router",
        {
          "root": "./client/app"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "extra": {
      "home": "app.backtickjs.com",
      "apps": "backtickjs.app",
      "supabaseUrl": "https://evgfuotcvraqxvdtutso.supabase.co",
      "supabasePublishableKey": "sb_publishable_EotSz0FFiuOqXCSjxqGYrQ_oRJqA0as",
      "eas": {
        "projectId": "baed8ee5-a651-438c-999f-aff346fa0064"
      }
    },
    "owner": "jbissons-team",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/baed8ee5-a651-438c-999f-aff346fa0064"
    }
  }
}
