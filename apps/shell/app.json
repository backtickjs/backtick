{
  "expo": {
    "name": "Backtick",
    "slug": "backtick",
    "scheme": "backtick",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.backtickjs.app",
      "appleTeamId": "BM4485734W"
    },
    "android": {
      "package": "com.backtickjs.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "*.backtickjs.app"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#181818"
      }
    },
    "plugins": [
      "@backtickjs/expo",
      [
        "expo-router",
        {
          "root": "./client/app"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          },
          "ios": {
            "deploymentTarget": "17.4"
          }
        }
      ],
      [
        "./modules/backtick-session/app.plugin.js",
        {
          "authorizationServer": "https://auth.backtickjs.com",
          "signInCallback": "https://app.backtickjs.com/signed-in"
        }
      ]
    ],
    "extra": {
      "home": "app.backtickjs.com",
      "apps": "backtickjs.app",
      "eas": {
        "projectId": "baed8ee5-a651-438c-999f-aff346fa0064"
      }
    },
    "owner": "jbissons-team",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/baed8ee5-a651-438c-999f-aff346fa0064"
    }
  }
}
