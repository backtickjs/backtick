{
  // What other projects import, built into build/ (dist/ is Expo's export): the screens in server/
  // (`shell/screens`), compiled with `tspc` from ts-patch since they're
  // scripts, with package.json's plugins (read beside this file); and the
  // module names (`shell/modules`).
  "extends": "./server/tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": "build",
    "declaration": true,
    "plugins": [{ "transform": "@backtickjs/tspatch-plugin" }]
  },
  "include": ["server", "client/modules.ts"]
}
