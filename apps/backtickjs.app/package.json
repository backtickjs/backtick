{
  "name": "backtickjs.app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Every app's host: <id>.backtickjs.app, for the phone and for a browser",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "clean": "rm -rf node_modules"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@backtickjs/prettier-plugin": "^0.2.4",
    "@types/node": "^25.9.1",
    "prettier": "^3.6.2"
  }
}
