{
  "name": "mcp.backtickjs.com-sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "What each user's sandbox runs: a server that typechecks and bundles apps, with the packages apps are checked against, the phone's (apps/shell) at its versions",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import @backtickjs/node-plugin --test \"test/**/*.test.ts\"",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "clean": "rm -rf node_modules .builds"
  },
