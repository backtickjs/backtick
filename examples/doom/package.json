{
  "name": "backtick-example-doom",
  "version": "1.0.0",
  "private": true,
  "description": "A Doom-like shooter drawn with React Three Fiber, its levels served by a Backtick server",
  "main": "client/index.ts",
  "scripts": {
    "server": "nodemon --exec \"node --enable-source-maps --import @backtickjs/node-plugin server/index.tsx\"",
    "start": "concurrently --raw --kill-others npm:server \"expo start\"",
    "android": "concurrently --raw --kill-others npm:server \"expo start --android\"",
    "ios": "concurrently --raw --kill-others npm:server \"expo start --ios\"",
    "web": "concurrently --raw --kill-others npm:server \"expo start --web\"",
    "typecheck": "tsc --noEmit && backtick-tsc -p server --noEmit",
    "test": "node --import ./server/test/setup.mjs --import @backtickjs/node-plugin --test \"server/**/*.test.ts\"",
    "register-build": "backtick-builds register",
    "eas-build-post-install": "backtick-builds check",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown ."
  },
  "dependencies": {
    "@backtickjs/builds": "^0.1.11",
    "@backtickjs/bundler": "^0.1.11",
    "@backtickjs/core": "^0.1.11",
    "@backtickjs/node-plugin": "^0.1.11",
    "@backtickjs/react": "^19.2.3",
    "@backtickjs/react-native": "^0.86.3",
    "@backtickjs/react-three-fiber": "^9.8.1",
    "@backtickjs/three": "^0.182.0",
    "@hono/node-server": "^2.1.4",
    "@react-three/fiber": "9.8.1",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.19",
    "expo-constants": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-gl": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "hono": "^4.13.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "6.1.6",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.0",
    "three": "0.182.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@backtickjs/prettier-plugin": "^0.1.11",
    "@backtickjs/tsc": "^0.1.11",
    "@react-three/test-renderer": "9.1.1",
    "@types/node": "^25.9.1",
    "@types/react": "19.2.18",
    "agent-device": "^0.21.27",
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.2"
  },
  "nodemonConfig": {
    "watch": [
      "server"
    ],
    "ext": "ts,tsx",
    "events": {
      "start": "node scripts/reload-expo.mjs"
    }
  },
  "backtick": {
    "clientRoot": "client",
    "plugins": [
      "@backtickjs/react/plugin"
    ]
  }
}
