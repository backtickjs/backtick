{
  "name": "@backtick/example-node-minimal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tspc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "clean": "rm -rf node_modules dist"
  },
  "dependencies": {
    "@backtick/core": "workspace:*",
    "@backtick/tspatch-plugin": "workspace:*"
  },
  "devDependencies": {
    "@backtick/prettier-plugin": "workspace:*",
    "prettier": "^3.6.2",
    "ts-patch": "^4.0.1",
    "typescript": "^6.0.3"
  }
}