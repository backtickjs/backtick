{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "plugins": [
      // Build with `tspc`, not `tsc`.
      { "transform": "@backtickjs/tspatch-plugin" }
    ]
  },
  "include": ["src"]
}
