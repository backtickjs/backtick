{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "plugins": [
      // Cmd+Shift+P → "TypeScript: Select TypeScript Version" → "Use Workspace Version"
      { "name": "@backtick/editor-plugin" },
      { "transform": "@backtick/tspatch-plugin" }
    ]
  },
  "include": ["src"]
}
