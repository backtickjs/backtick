{
  "name": "@backtickjs/example-weather-card",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "backtick-tsc --noEmit",
    "start": "backtick-bun-watch src/index.tsx",
    "clean": "rm -rf node_modules dist"
  },
  "dependencies": {
    "@backtickjs/bun-plugin": "^0.1.0",
    "@backtickjs/bundler": "^0.1.0",
    "@backtickjs/core": "^0.1.0",
    "@backtickjs/solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@backtickjs/prettier-plugin": "^0.1.0",
    "@backtickjs/tsc": "^0.1.0",
    "@types/bun": "^1.3.14",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "backtick": {
    "plugins": [
      "@backtickjs/solid-js/plugin"
    ]
  }
}
