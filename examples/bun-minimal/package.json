{
  "name": "@backtickjs/example-bun-minimal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "backtick-tsc --noEmit",
    "start": "bun src/index.tsx",
    "clean": "rm -rf node_modules"
  },
  "dependencies": {
    "@backtickjs/bun-plugin": "^0.1.0",
    "@backtickjs/bundler": "workspace:*",
    "@backtickjs/core": "^0.1.0",
    "@backtickjs/web-client": "workspace:*",
    "@backtickjs/web-page": "workspace:*"
  },
  "devDependencies": {
    "@backtickjs/prettier-plugin": "^0.1.0",
    "@backtickjs/tsc": "^0.1.0",
    "@types/bun": "^1.3.14",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
