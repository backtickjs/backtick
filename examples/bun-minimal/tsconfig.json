{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["bun"],
    "plugins": [
      // Cmd+Shift+P → "TypeScript: Select TypeScript Version" → "Use Workspace Version"
      { "name": "@backtick/editor-plugin" }
    ]
  },
  "include": ["src"]
}
